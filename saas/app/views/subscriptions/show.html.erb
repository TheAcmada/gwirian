<% content_for :title, "Subscription" %>
<style>
  /* Subscription plan action buttons: show loading indicator during htmx request */
  .subscription-btn-indicator { display: none !important; }
  .subscription-btn-indicator.htmx-request { display: inline-flex !important; }
  form.htmx-request .subscription-btn-content { display: none !important; }
</style>
<div class="max-w-3xl mx-auto px-4 py-12"
  data-status-url="<%= status_subscription_path %>"
  data-upgrade-pending="<%= @upgrade_pending %>"
  x-data="subscriptionUpgradePoll($el)"
  x-init="init()">
  <%= render Shared::PageHeaderComponent.new(
    title: "Subscription",
    subtitle: "Manage your workspace plan and billing"
  ) %>

  <% if @upgrade_pending %>
    <div class="mb-6 p-4 rounded-lg bg-accent-50 dark:bg-accent-900/20 ring-1 ring-accent-500/30" x-show="polling" x-cloak>
      <p class="text-sm text-stone-700 dark:text-white/80 flex items-center gap-2">
        <span class="inline-flex animate-spin h-4 w-4 rounded-full border-2 border-accent-500 border-t-transparent" aria-hidden="true"></span>
        Payment received. Finalizing your plan upgrade…
      </p>
    </div>
    <div class="mb-6 p-4 rounded-lg bg-stone-100 dark:bg-white/10 text-stone-600 dark:text-white/70 text-sm" x-show="timedOut" x-cloak style="display: none;">
      <p>If your plan doesn't update, <a href="<%= subscription_path %>" class="font-medium underline hover:no-underline">refresh the page</a> or contact support.</p>
    </div>
  <% end %>

  <script>
    function registerSubscriptionUpgradePoll() {
      Alpine.data('subscriptionUpgradePoll', function(el) {
        return {
          polling: false,
          timedOut: false,
          statusUrl: el && el.dataset && el.dataset.statusUrl,
          pending: el && el.dataset && el.dataset.upgradePending === 'true',
          intervalId: null,
          timeoutId: null,
          init() {
            if (!this.pending || !this.statusUrl) return;
            this.polling = true;
            var self = this;
            var deadline = Date.now() + 20000;
            function poll() {
              if (Date.now() >= deadline) {
                self.polling = false;
                self.timedOut = true;
                return;
              }
              fetch(self.statusUrl, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                  if (data && data.paid) {
                    window.location.reload();
                    return;
                  }
                  self.intervalId = setTimeout(poll, 2500);
                })
                .catch(function() {
                  self.intervalId = setTimeout(poll, 2500);
                });
            }
            this.intervalId = setTimeout(poll, 2000);
            this.timeoutId = setTimeout(function() {
              if (self.polling) {
                self.polling = false;
                self.timedOut = true;
              }
            }, 20000);
          }
        };
      });
    }
    if (window.Alpine) {
      registerSubscriptionUpgradePoll();
    } else {
      document.addEventListener('alpine:init', registerSubscriptionUpgradePoll);
    }
  </script>

  <div class="space-y-8">
    <!-- Current Plan -->
    <div>
      <h2 class="text-sm font-medium mb-4 text-stone-500 dark:text-white/60">Current plan</h2>
      <div class="bg-stone-50 dark:bg-white/5 rounded-lg p-4">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-stone-800 dark:text-white/90 font-medium text-lg"><%= @plan.name %></p>
            <% if @subscription&.paid? %>
              <p class="text-xs text-stone-500 dark:text-white/40 mt-1">
                <% if @subscription.can_undo_scheduled_change? %>
                  Downgrade to Free scheduled for <%= @subscription.scheduled_change_effective_at.strftime("%B %d, %Y") %>
                  <span class="block mt-1">You keep <%= @plan.name %> until then. You can undo by clicking <strong>Keep this plan</strong> below.</span>
                <% elsif @subscription.active? %>
                  Active
                  <% if @subscription.current_period_ends_at.present? %>
                    &middot; Renews <%= @subscription.current_period_ends_at.strftime("%B %d, %Y") %>
                  <% end %>
                <% elsif @subscription.canceled? && @subscription.on_grace_period? %>
                  Cancels on <%= @subscription.current_period_ends_at.strftime("%B %d, %Y") %>
                  <span class="block mt-1">You keep <%= @plan.name %> until then. You can undo by clicking <strong>Keep this plan</strong> below.</span>
                <% elsif @subscription.canceled? %>
                  Canceled
                <% elsif @subscription.paused? %>
                  Paused
                <% elsif @subscription.past_due? %>
                  Past due &mdash; please update your payment method
                <% end %>
              </p>
            <% else %>
              <p class="text-xs text-stone-500 dark:text-white/40 mt-1">Free plan with limited resources</p>
            <% end %>
          </div>
          <% if @subscription&.paddle_customer_id.present? %>
            <a href="<%= portal_subscription_path %>" class="btn btn-secondary btn-sm" hx-boost="false">Manage billing</a>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Usage -->
    <%= render "subscriptions/usage", workspace: @workspace %>

    <!-- Plans -->
    <div>
      <h2 class="text-sm font-medium mb-4 text-stone-500 dark:text-white/60">Available plans</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% @plans.each do |plan| %>
          <div class="rounded-lg p-5 <%= plan.key == @plan.key ? 'bg-accent-50 dark:bg-accent-900/20 ring-1 ring-accent-500/30' : 'bg-stone-50 dark:bg-white/5' %>">
            <div class="flex items-center justify-between mb-3">
              <h3 class="font-medium text-stone-800 dark:text-white/90"><%= plan.name %></h3>
              <% if plan.key == @plan.key %>
                <span class="badge badge-accent badge-sm">Current</span>
              <% end %>
            </div>

            <dl class="space-y-1 text-xs text-stone-500 dark:text-white/50 mb-4">
              <div class="flex justify-between">
                <dt>Projects</dt>
                <dd><%= plan_limit_display(plan.projects_limit) %></dd>
              </div>
              <div class="flex justify-between">
                <dt>Features</dt>
                <dd><%= plan_limit_display(plan.features_limit) %></dd>
              </div>
              <div class="flex justify-between">
                <dt>Scenarios</dt>
                <dd><%= plan_limit_display(plan.scenarios_limit) %></dd>
              </div>
              <div class="flex justify-between">
                <dt>Members</dt>
                <dd><%= plan_limit_display(plan.members_limit) %></dd>
              </div>
            </dl>

            <% if plan.key != @plan.key %>
              <% if plan.free? %>
                <% if @subscription&.paddle_subscription_id.present? && !@subscription.canceled? && !@subscription.pending_scheduled_change? %>
                  <% cancel_url = cancel_subscription_path %>
                  <% downgrade_confirm_msg = "This will cancel your paid subscription at the end of the current billing period. You keep access until that date." %>
                  <form method="post" action="<%= cancel_url %>" class="w-full"
                        hx-post="<%= cancel_url %>" hx-target="body" hx-swap="innerHTML" hx-push-url="true"
                        hx-disabled-elt="button[type=submit]" hx-indicator="#subscription-downgrade-indicator">
                    <%= tag.input name: "authenticity_token", value: form_authenticity_token, type: "hidden" %>
                    <button type="submit" class="btn btn-secondary btn-sm w-full"
                            x-data="{}"
                            @click.prevent="showConfirmation(<%= downgrade_confirm_msg.to_json %>).then(result => { if (result.isConfirmed) $el.closest('form').requestSubmit() })">
                      <span class="subscription-btn-content">Downgrade to Free</span>
                      <span id="subscription-downgrade-indicator" class="subscription-btn-indicator inline-flex items-center gap-2" style="display: none;">
                        <span class="inline-flex animate-spin h-4 w-4 rounded-full border-2 border-accent-500 border-t-transparent" aria-hidden="true"></span>
                        Downgrading…
                      </span>
                    </button>
                  </form>
                  <p class="text-xs text-stone-500 dark:text-white/50 mt-2">You'll keep your current plan until the end of the billing period.</p>
                <% end %>
              <% elsif plan.paid? && plan.paddle_price_id.present? %>
                <% if @plan.free? %>
                  <%= link_to "Upgrade to #{plan.name}",
                        new_subscription_path(plan_key: plan.key),
                        class: "btn btn-primary btn-sm w-full block text-center" %>
                  <p class="text-xs text-stone-500 dark:text-white/50 mt-2">Complete checkout on the next page.</p>
                <% elsif @subscription.active? && !@subscription.canceled? && !@subscription.pending_scheduled_change? %>
                  <% switch_url = update_plan_subscription_path(plan_key: plan.key) %>
                  <form method="post" action="<%= switch_url %>" class="w-full"
                        hx-post="<%= switch_url %>" hx-target="body" hx-swap="innerHTML" hx-push-url="true"
                        hx-disabled-elt="button[type=submit]" hx-indicator="#subscription-switch-indicator-<%= plan.key %>">
                    <%= tag.input name: "authenticity_token", value: form_authenticity_token, type: "hidden" %>
                    <button type="submit" class="btn btn-primary btn-sm w-full">
                      <span class="subscription-btn-content">Switch to <%= plan.name %></span>
                      <span id="subscription-switch-indicator-<%= plan.key %>" class="subscription-btn-indicator inline-flex items-center gap-2" style="display: none;">
                        <span class="inline-flex animate-spin h-4 w-4 rounded-full border-2 border-accent-500 border-t-transparent" aria-hidden="true"></span>
                        Switching…
                      </span>
                    </button>
                  </form>
                <% end %>
              <% end %>
            <% else %>
              <% if @subscription&.paid? && @subscription&.can_undo_scheduled_change? %>
                <% keep_url = keep_plan_subscription_path %>
                <form method="post" action="<%= keep_url %>" class="w-full"
                      hx-post="<%= keep_url %>" hx-target="body" hx-swap="innerHTML" hx-push-url="true"
                      hx-disabled-elt="button[type=submit]" hx-indicator="#subscription-keep-indicator">
                  <%= tag.input name: "authenticity_token", value: form_authenticity_token, type: "hidden" %>
                  <button type="submit" class="btn btn-primary btn-sm w-full">
                    <span class="subscription-btn-content">Keep this plan</span>
                    <span id="subscription-keep-indicator" class="subscription-btn-indicator inline-flex items-center gap-2" style="display: none;">
                      <span class="inline-flex animate-spin h-4 w-4 rounded-full border-2 border-accent-500 border-t-transparent" aria-hidden="true"></span>
                      Keeping…
                    </span>
                  </button>
                </form>
              <% elsif @subscription&.paused? %>
                <% resume_url = resume_subscription_path %>
                <form method="post" action="<%= resume_url %>" class="w-full"
                      hx-post="<%= resume_url %>" hx-target="body" hx-swap="innerHTML" hx-push-url="true"
                      hx-disabled-elt="button[type=submit]" hx-indicator="#subscription-resume-indicator">
                  <%= tag.input name: "authenticity_token", value: form_authenticity_token, type: "hidden" %>
                  <button type="submit" class="btn btn-primary btn-sm w-full">
                    <span class="subscription-btn-content">Resume plan</span>
                    <span id="subscription-resume-indicator" class="subscription-btn-indicator inline-flex items-center gap-2" style="display: none;">
                      <span class="inline-flex animate-spin h-4 w-4 rounded-full border-2 border-accent-500 border-t-transparent" aria-hidden="true"></span>
                      Resuming…
                    </span>
                  </button>
                </form>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
