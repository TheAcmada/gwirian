<% if can_edit? %>
  <div
    class="<%= css_class %>"
    x-data="{
      showAddInput: false,
      newTagName: '',
      cancelAdd() {
        this.newTagName = '';
        this.showAddInput = false;
      }
    }"
    x-on:htmx:after-swap.window="if ($event.detail.target.closest('[data-feature-header]')) { showAddInput = false; newTagName = ''; }"
    x-on:mouseenter="$refs.addButton?.classList.remove('opacity-0')"
    x-on:mouseleave="if (!showAddInput) $refs.addButton?.classList.add('opacity-0')"
  >
    <div class="flex flex-wrap gap-1.5 items-center min-h-[1.5rem]">
      <% if tags&.any? %>
        <% tags.each do |tag| %>
          <span class="badge badge-sm <%= tag_color_class(tag) %> inline-flex items-center gap-1 group">
            <%= tag.name %>
            <button
              type="button"
              hx-delete="<%= remove_tag_path(tag.name) %>"
              hx-vals='{"tag_name": <%= tag.name.to_json %>}'
              hx-target="closest [data-feature-header]"
              hx-swap="outerHTML"
              class="opacity-0 group-hover:opacity-100 transition-opacity ml-0.5 hover:text-red-500 focus:outline-none focus:ring-1 focus:ring-red-500 rounded cursor-pointer"
              aria-label="Remove tag <%= tag.name %>"
            >
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </span>
        <% end %>
      <% end %>

      <form
        x-ref="addTagForm"
        x-show="showAddInput"
        x-transition
        hx-post="<%= add_tag_path %>"
        hx-target="closest [data-feature-header]"
        hx-swap="outerHTML"
        hx-trigger="submit"
        hx-on::after-swap="showAddInput = false; newTagName = '';"
        class="inline-flex items-center gap-1"
        style="display: none;"
      >
        <input
          type="text"
          name="tag_name"
          x-model="newTagName"
          x-ref="tagInput"
          x-on:blur="if (!newTagName.trim()) cancelAdd()"
          x-on:keydown.escape.prevent="cancelAdd()"
          x-init="$watch('showAddInput', value => value && $nextTick(() => $refs.tagInput?.focus()))"
          class="px-2 py-0.5 text-sm border border-stone-300 dark:border-stone-600 rounded bg-white dark:bg-stone-900 text-stone-900 dark:text-stone-100 focus:outline-none focus:ring-2 focus:ring-accent-500 w-24"
          placeholder="Tag name"
          autocomplete="off"
          required
        />
      </form>
      <button
        x-ref="addButton"
        type="button"
        x-show="!showAddInput"
        x-on:click="showAddInput = true"
        class="opacity-0 transition-opacity inline-flex items-center justify-center w-5 h-5 rounded border border-stone-300 dark:border-stone-600 hover:border-stone-400 dark:hover:border-stone-500 hover:bg-stone-100 dark:hover:bg-stone-800 text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 focus:outline-none focus:ring-2 focus:ring-accent-500 cursor-pointer"
        aria-label="Add tag"
        title="Add tag"
      >
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
      </button>
    </div>
  </div>
<% else %>
  <% if tags&.any? %>
    <div class="<%= css_class %> flex flex-wrap gap-1.5">
      <% tags.each do |tag| %>
        <span class="badge badge-sm <%= tag_color_class(tag) %>"><%= tag.name %></span>
      <% end %>
    </div>
  <% end %>
<% end %>
