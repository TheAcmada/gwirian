<div
  id="<%= wrapper_id %>"
  class="scenario-item group relative py-2 px-2 -mx-2 rounded transition-colors duration-75 hover:bg-stone-50 dark:hover:bg-white/5"
  x-data="{
    expanded: true,
    givenText: <%= given_text.to_json %>,
    whenText: <%= when_text.to_json %>,
    thenText: <%= then_text.to_json %>,
    updateGiven(event) {
      this.givenText = event.target.innerText.trim();
      setTimeout(() => htmx.trigger(event.target, 'save-given'), 10);
    },
    updateWhen(event) {
      this.whenText = event.target.innerText.trim();
      setTimeout(() => htmx.trigger(event.target, 'save-when'), 10);
    },
    updateThen(event) {
      this.thenText = event.target.innerText.trim();
      setTimeout(() => htmx.trigger(event.target, 'save-then'), 10);
    }
  }"
  data-id="<%= scenario.id %>"
>
  <form id="<%= form_id %>" style="display: none;">
    <input type="hidden" name="scenario[given]" x-bind:value="givenText">
    <input type="hidden" name="scenario[when]" x-bind:value="whenText">
    <input type="hidden" name="scenario[then]" x-bind:value="thenText">
  </form>

  <div class="flex items-center gap-2">
    <% if helpers.can?(:update, scenario) %>
      <div class="drag-handle flex-shrink-0 flex items-center justify-center w-5 h-5 rounded cursor-grab active:cursor-grabbing" title="Drag to reorder">
        <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <circle cx="9" cy="6" r="1.5"/>
          <circle cx="9" cy="12" r="1.5"/>
          <circle cx="9" cy="18" r="1.5"/>
          <circle cx="15" cy="6" r="1.5"/>
          <circle cx="15" cy="12" r="1.5"/>
          <circle cx="15" cy="18" r="1.5"/>
        </svg>
      </div>
    <% end %>

    <button
      type="button"
      @click="expanded = !expanded"
      class="flex-shrink-0 flex items-center justify-center w-5 h-5 rounded cursor-pointer transition-colors hover:bg-stone-100 dark:hover:bg-white/10 text-stone-400 dark:text-white/30"
      aria-label="Toggle scenario details"
    >
      <svg
        class="w-3 h-3 transition-transform duration-150"
        :class="{ 'rotate-90': expanded }"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>

    <div class="flex-shrink-0 <%= status_color %>">
      <%= raw status_icon %>
    </div>

    <div class="flex-1 min-w-0">
      <%= render Scenarios::TitleComponent.new(scenario: scenario, feature: feature, project: project) %>
    </div>

    <% if helpers.can?(:destroy, scenario) %>
      <%= render Scenarios::DropdownMenuComponent.new(scenario: scenario, feature: feature, project: project) %>
    <% end %>
  </div>

  <div
    x-show="expanded"
    x-transition:enter="transition ease-out duration-150"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-100"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    x-cloak
    class="mt-2 ml-7 pl-3 border-l border-stone-200 dark:border-white/10"
  >
    <% if latest_execution %>
      <div class="mb-2 pb-2 text-xs text-stone-400 dark:text-white/40 border-b border-stone-100 dark:border-white/5">
        Last run: <%= latest_execution.executed_at.strftime("%b %d, %Y at %I:%M %p") %>
        <% if latest_execution.notes.present? %>
          <div class="mt-0.5 text-stone-500 dark:text-white/60"><%= latest_execution.notes %></div>
        <% end %>
      </div>
    <% end %>

    <div class="space-y-2 text-sm">
      <div class="flex gap-2">
        <span class="flex-shrink-0 text-xs font-medium uppercase tracking-wider pt-0.5 w-10 text-emerald-600 dark:text-emerald-400">Given</span>
        <span
          class="flex-1 text-stone-800 dark:text-white/90 leading-relaxed editable-placeholder is-editable"
          contenteditable="true"
          data-placeholder="Describe the initial context..."
          x-on:blur="updateGiven($event)"
          hx-patch="<%= update_path %>"
          hx-trigger="save-given"
          hx-include="#<%= form_id %>"
          hx-swap="none"
        ><%= scenario.given.to_s.strip.presence %></span>
      </div>
      <div class="flex gap-2">
        <span class="flex-shrink-0 text-xs font-medium uppercase tracking-wider pt-0.5 w-10 text-blue-600 dark:text-blue-400">When</span>
        <span
          class="flex-1 text-stone-800 dark:text-white/90 leading-relaxed editable-placeholder is-editable"
          contenteditable="true"
          data-placeholder="Describe the action or event..."
          x-on:blur="updateWhen($event)"
          hx-patch="<%= update_path %>"
          hx-trigger="save-when"
          hx-include="#<%= form_id %>"
          hx-swap="none"
        ><%= scenario[:when].to_s.strip.presence %></span>
      </div>
      <div class="flex gap-2">
        <span class="flex-shrink-0 text-xs font-medium uppercase tracking-wider pt-0.5 w-10 text-purple-600 dark:text-purple-400">Then</span>
        <span
          class="flex-1 text-stone-800 dark:text-white/90 leading-relaxed editable-placeholder is-editable"
          contenteditable="true"
          data-placeholder="Describe the expected outcome..."
          x-on:blur="updateThen($event)"
          hx-patch="<%= update_path %>"
          hx-trigger="save-then"
          hx-include="#<%= form_id %>"
          hx-swap="none"
        ><%= scenario[:then].to_s.strip.presence %></span>
      </div>
    </div>
  </div>
</div>
