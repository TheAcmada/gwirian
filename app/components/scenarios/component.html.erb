<div
  id="<%= wrapper_id %>"
  class="scenario-item group relative p-4 bg-white dark:bg-gray-800 rounded-xl border border-zinc-200 dark:border-gray-700 hover:border-zinc-300 dark:hover:border-gray-600 transition-all duration-150"
  x-data="{
    expanded: true,
    givenText: <%= given_text.to_json %>,
    whenText: <%= when_text.to_json %>,
    thenText: <%= then_text.to_json %>,
    updateGiven(event) {
      this.givenText = event.target.innerText.trim();
      setTimeout(() => htmx.trigger(event.target, 'save-given'), 10);
    },
    updateWhen(event) {
      this.whenText = event.target.innerText.trim();
      setTimeout(() => htmx.trigger(event.target, 'save-when'), 10);
    },
    updateThen(event) {
      this.thenText = event.target.innerText.trim();
      setTimeout(() => htmx.trigger(event.target, 'save-then'), 10);
    }
  }"
  data-id="<%= scenario.id %>"
>
  <form id="<%= form_id %>" style="display: none;">
    <input type="hidden" name="scenario[given]" x-bind:value="givenText">
    <input type="hidden" name="scenario[when]" x-bind:value="whenText">
    <input type="hidden" name="scenario[then]" x-bind:value="thenText">
  </form>

  <div class="flex items-center gap-3">
    <% if helpers.can?(:update, scenario) %>
      <div class="drag-handle flex-shrink-0 flex items-center justify-center w-6 h-8 -ml-1 rounded text-zinc-400 dark:text-gray-500 hover:text-zinc-600 dark:hover:text-gray-300 hover:bg-zinc-100 dark:hover:bg-gray-700 transition-all" title="Drag to reorder">
        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <circle cx="9" cy="6" r="1.5"/>
          <circle cx="9" cy="12" r="1.5"/>
          <circle cx="9" cy="18" r="1.5"/>
          <circle cx="15" cy="6" r="1.5"/>
          <circle cx="15" cy="12" r="1.5"/>
          <circle cx="15" cy="18" r="1.5"/>
        </svg>
      </div>
    <% end %>

    <button
      type="button"
      @click="expanded = !expanded"
      class="flex-shrink-0 flex items-center justify-center w-6 h-6 rounded text-zinc-400 cursor-pointer dark:text-gray-500 hover:text-zinc-600 dark:hover:text-gray-300 hover:bg-zinc-100 dark:hover:bg-gray-700 transition-all"
      aria-label="Toggle scenario details"
    >
      <svg
        class="w-4 h-4 transition-transform duration-200"
        :class="{ 'rotate-90': expanded }"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>

    <div class="flex-1 min-w-0">
      <%= render Scenarios::TitleComponent.new(scenario: scenario, feature: feature, project: project) %>
    </div>

    <% if helpers.can?(:destroy, scenario) %>
      <%= render Scenarios::DropdownMenuComponent.new(scenario: scenario, feature: feature, project: project) %>
    <% end %>
  </div>

  <div
    x-show="expanded"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-1"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-1"
    x-cloak
    class="mt-4 ml-9 pl-3 border-l-2 border-zinc-200 dark:border-gray-700"
  >
    <div class="space-y-3 text-sm">
      <div class="flex gap-3">
        <span class="flex-shrink-0 font-semibold text-emerald-600 dark:text-emerald-400 uppercase text-xs tracking-wide pt-0.5 w-12">Given</span>
        <span
          class="flex-1 text-zinc-600 dark:text-gray-300 leading-relaxed editable-placeholder is-editable"
          contenteditable="true"
          data-placeholder="Describe the initial context..."
          x-on:blur="updateGiven($event)"
          hx-patch="<%= update_path %>"
          hx-trigger="save-given"
          hx-include="#<%= form_id %>"
          hx-swap="none"
        ><%= scenario.given.to_s.strip.presence %></span>
      </div>
      <div class="flex gap-3">
        <span class="flex-shrink-0 font-semibold text-blue-600 dark:text-blue-400 uppercase text-xs tracking-wide pt-0.5 w-12">When</span>
        <span
          class="flex-1 text-zinc-600 dark:text-gray-300 leading-relaxed editable-placeholder is-editable"
          contenteditable="true"
          data-placeholder="Describe the action or event..."
          x-on:blur="updateWhen($event)"
          hx-patch="<%= update_path %>"
          hx-trigger="save-when"
          hx-include="#<%= form_id %>"
          hx-swap="none"
        ><%= scenario[:when].to_s.strip.presence %></span>
      </div>
      <div class="flex gap-3">
        <span class="flex-shrink-0 font-semibold text-purple-600 dark:text-purple-400 uppercase text-xs tracking-wide pt-0.5 w-12">Then</span>
        <span
          class="flex-1 text-zinc-600 dark:text-gray-300 leading-relaxed editable-placeholder is-editable"
          contenteditable="true"
          data-placeholder="Describe the expected outcome..."
          x-on:blur="updateThen($event)"
          hx-patch="<%= update_path %>"
          hx-trigger="save-then"
          hx-include="#<%= form_id %>"
          hx-swap="none"
        ><%= scenario[:then].to_s.strip.presence %></span>
      </div>
    </div>
  </div>
</div>
