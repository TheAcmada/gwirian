<%= link_to project_path(project), class: "block h-full group" do %>
  <div class="project-card p-5 h-full rounded border border-stone-200 dark:border-white/10 hover:border-stone-300 dark:hover:border-white/20 transition-all duration-200 hover:bg-stone-50/80 dark:hover:bg-white/[0.03] flex flex-col">
    <%# Header: Title and Description %>
    <div class="mb-4">
      <h2 class="text-base font-semibold mb-2 text-stone-900 dark:text-white group-hover:text-stone-950 dark:group-hover:text-white transition-colors duration-200 leading-tight">
        <%= project.name %>
      </h2>

      <% if project.description.present? %>
        <p class="text-sm text-stone-600 dark:text-white/60 line-clamp-2 leading-relaxed">
          <%= project.description %>
        </p>
      <% else %>
        <p class="text-sm italic text-stone-400 dark:text-white/40 leading-relaxed">
          No description
        </p>
      <% end %>
    </div>

    <%# Progress Section %>
    <div class="flex-1 flex flex-col justify-center mb-4">
      <% if has_executions? %>
        <div class="space-y-3">
          <%# Success rate display %>
          <div class="text-center">
            <div class="text-2xl font-semibold text-stone-900 dark:text-white mb-0.5"><%= success_rate %>%</div>
            <div class="text-xs text-stone-500 dark:text-white/50">success rate</div>
          </div>

          <%# Progress bar %>
          <div class="space-y-2">
            <div class="h-2.5 w-full bg-stone-100 dark:bg-white/8 rounded-full overflow-hidden flex">
              <% if passed_percentage > 0 %>
                <div class="h-full bg-emerald-500 dark:bg-emerald-500 transition-all duration-200" style="width: <%= passed_percentage %>%"></div>
              <% end %>
              <% if failed_percentage > 0 %>
                <div class="h-full bg-red-500 dark:bg-red-500 transition-all duration-200" style="width: <%= failed_percentage %>%"></div>
              <% end %>
              <% if pending_percentage > 0 %>
                <div class="h-full bg-stone-300 dark:bg-white/25 transition-all duration-200" style="width: <%= pending_percentage %>%"></div>
              <% end %>
            </div>

            <%# Legend %>
            <div class="flex items-center justify-center gap-4 text-xs">
              <% if execution_stats[:passed] > 0 %>
                <span class="flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400">
                  <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                  </svg>
                  <span class="font-medium"><%= execution_stats[:passed] %></span>
                </span>
              <% end %>
              <% if execution_stats[:failed] > 0 %>
                <span class="flex items-center gap-1.5 text-red-600 dark:text-red-400">
                  <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m9.75 9.75 4.5 4.5m0-4.5-4.5 4.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                  </svg>
                  <span class="font-medium"><%= execution_stats[:failed] %></span>
                </span>
              <% end %>
              <% if execution_stats[:pending] > 0 %>
                <span class="flex items-center gap-1.5 text-stone-500 dark:text-white/55">
                  <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                  </svg>
                  <span class="font-medium"><%= execution_stats[:pending] %></span>
                </span>
              <% end %>
            </div>
          </div>
        </div>
      <% else %>
        <div class="flex items-center justify-center py-8">
          <div class="text-center">
            <svg class="w-12 h-12 mx-auto mb-2 text-stone-300 dark:text-white/20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
            <p class="text-xs text-stone-400 dark:text-white/40">No executions yet</p>
          </div>
        </div>
      <% end %>
    </div>

    <%# Footer: Metrics and Activity %>
    <div class="pt-3 border-t border-stone-100 dark:border-white/5 space-y-2">
      <%# Compact metrics %>
      <div class="flex items-center justify-between text-xs text-stone-500 dark:text-white/50">
        <div class="flex items-center gap-3">
          <span><span class="font-medium text-stone-700 dark:text-white/70"><%= features_count %></span> features</span>
          <span><span class="font-medium text-stone-700 dark:text-white/70"><%= scenarios_count %></span> scenarios</span>
          <span><span class="font-medium text-stone-700 dark:text-white/70"><%= members_count %></span> members</span>
        </div>
        <% if has_executions? %>
          <div class="flex items-center gap-2">
            <% if execution_stats[:failed] > 0 %>
              <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-medium bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400">
                <%= execution_stats[:failed] %> failed
              </span>
            <% end %>
          </div>
        <% end %>
      </div>

      <%# Last activity %>
      <div class="text-[10px] text-stone-400 dark:text-white/35">
        Updated <%= last_activity_text %>
      </div>
    </div>
  </div>
<% end %>

