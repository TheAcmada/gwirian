<div class="<%= color_classes[:bg] %> rounded-xl flex flex-col gap-1 <%= hero? ? 'p-6 lg:p-8' : 'p-5' %>">
  <span class="font-medium uppercase tracking-wide <%= color_classes[:label] %> <%= hero? ? 'text-xs lg:text-sm' : 'text-xs' %>">
    <%= label %>
  </span>
  
  <div class="flex items-baseline gap-2 flex-wrap">
    <span class="font-bold tracking-tight tabular-nums <%= color_classes[:text] %> <%= hero? ? 'text-4xl lg:text-5xl' : 'text-3xl' %>">
      <%= value %><%= suffix if suffix.present? %>
    </span>
    
    <% if show_trend? %>
      <span class="flex items-center gap-0.5 text-sm font-medium <%= trend_data[:color] %>">
        <span><%= trend_data[:icon] %></span>
        <span><%= trend_value %></span>
      </span>
    <% end %>
  </div>
  
  <% if show_trend_context? %>
    <div class="text-xs <%= color_classes[:label] %> <%= hero? ? 'mt-2' : 'mt-1' %>">
      <% if trend_previous_value.present? %>
        <span>was <%= trend_previous_value %><%= suffix if suffix.present? %></span>
      <% end %>
      <% if trend_period_label.present? %>
        <span><%= trend_previous_value.present? ? ' • ' : '' %><%= trend_period_label %></span>
      <% end %>
    </div>
  <% end %>
</div>

