<div class="<%= color_classes[:bg] %> rounded-xl p-5 flex flex-col gap-1">
  <span class="text-xs font-medium uppercase tracking-wide <%= color_classes[:label] %>">
    <%= label %>
  </span>
  
  <div class="flex items-baseline gap-2">
    <span class="text-3xl font-bold tracking-tight <%= color_classes[:text] %>">
      <%= value %><%= suffix if suffix.present? %>
    </span>
    
    <% if show_trend? %>
      <span class="flex items-center gap-0.5 text-sm font-medium <%= trend_data[:color] %>">
        <span><%= trend_data[:icon] %></span>
        <span><%= trend_value %></span>
      </span>
    <% end %>
  </div>
  
  <% if show_trend_context? %>
    <div class="text-xs <%= color_classes[:label] %> mt-1">
      <% if trend_previous_value.present? %>
        <span>was <%= trend_previous_value %><%= suffix if suffix.present? %></span>
      <% end %>
      <% if trend_period_label.present? %>
        <span><%= trend_previous_value.present? ? ' • ' : '' %><%= trend_period_label %></span>
      <% end %>
    </div>
  <% end %>
</div>

