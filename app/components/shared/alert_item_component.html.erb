<%= content_tag(wrapper_tag, **wrapper_attributes) do %>
  <%# Severity indicator dot %>
  <div class="flex-shrink-0 mt-1">
    <div class="w-2 h-2 rounded-full <%= severity_classes[:dot] %>"></div>
  </div>
  
  <%# Content %>
  <div class="flex-1 min-w-0">
    <div class="flex items-start justify-between gap-2">
      <span class="text-sm font-medium <%= severity_classes[:text] %> truncate">
        <%= title %>
      </span>
      
      <% if timestamp.present? %>
        <span class="text-xs text-stone-400 dark:text-stone-500 whitespace-nowrap flex-shrink-0">
          <%= formatted_timestamp %>
        </span>
      <% end %>
    </div>
    
    <% if description.present? %>
      <p class="text-xs text-stone-500 dark:text-stone-400 mt-0.5 truncate">
        <%= description %>
      </p>
    <% end %>
  </div>
  
  <% if link.present? %>
    <%# Chevron icon for links %>
    <div class="flex-shrink-0 text-stone-400 dark:text-stone-500">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </div>
  <% end %>
<% end %>

