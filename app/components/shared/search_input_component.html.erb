<div class="relative" x-data="{ query: '' }" x-init="query = $refs.searchInput.value">
  <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-400 dark:text-white/40 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
  </svg>
  <input type="text"
         name="<%= param_name %>"
         x-ref="searchInput"
         x-model="query"
         value="<%= value %>"
         placeholder="<%= placeholder %>"
         class="input w-full pl-10 pr-10"
         autocomplete="off"
         hx-get="<%= url %>"
         hx-trigger="keyup changed delay:300ms"
         hx-target="#<%= target_id %>"
         hx-select="#<%= target_id %>"
         hx-swap="outerHTML"
         hx-push-url="true" />
  <button type="button"
          x-show="query.length > 0"
          x-cloak
          @click="query = ''; $refs.searchInput.value = ''; htmx.ajax('GET', '<%= url %>', {target: '#<%= target_id %>', select: '#<%= target_id %>', swap: 'outerHTML'})"
          class="absolute right-3 top-1/2 -translate-y-1/2 text-stone-400 hover:text-stone-600 dark:text-white/40 dark:hover:text-white/70 transition-colors cursor-pointer"
          title="Clear search">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>
</div>
