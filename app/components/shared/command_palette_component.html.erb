<div
  x-data="commandPalette()"
  x-init="initFromDataset()"
  data-config="<%= ERB::Util.html_escape_once(config_json) %>"
  x-cloak
  @keydown.window="
    if ($event.key === 'k' && ($event.ctrlKey || $event.metaKey)) {
      $event.preventDefault();
      open = !open;
      if (open) { query = ''; searchResults = []; selectedIndex = 0; $nextTick(() => $refs.searchInput?.focus()); }
    }
    if ($event.key === 'Escape') { open = false; }
  "
  @command-palette:open.window="open = true; query = ''; searchResults = []; selectedIndex = 0; $nextTick(() => $refs.searchInput?.focus())"
  x-show="open"
  x-transition:enter="transition ease-out duration-150"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition ease-in duration-100"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  class="fixed inset-0 z-50 flex items-start justify-center pt-[15vh] px-4 bg-stone-900/50 dark:bg-black/60 backdrop-blur-sm"
  @click.self="open = false"
  role="dialog"
  aria-modal="true"
  aria-label="Search and commands"
>
  <div
    class="w-full max-w-xl rounded-lg bg-white dark:bg-[rgb(37,37,37)] border border-stone-200 dark:border-white/10 shadow-xl overflow-hidden"
    style="box-shadow: rgba(15, 15, 15, 0.05) 0px 0px 0px 1px, rgba(15, 15, 15, 0.1) 0px 3px 6px, rgba(15, 15, 15, 0.2) 0px 9px 24px;"
    @keydown.window="
      if (!open) return;
      if ($event.key === 'ArrowDown') { $event.preventDefault(); selectedIndex = Math.min(selectedIndex + 1, items.length - 1); }
      if ($event.key === 'ArrowUp') { $event.preventDefault(); selectedIndex = Math.max(selectedIndex - 1, 0); }
      if ($event.key === 'Enter' && items[selectedIndex]) { $event.preventDefault(); selectResult(items[selectedIndex]); }
    "
  >
    <div class="relative border-b border-stone-100 dark:border-white/10">
      <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-stone-400 dark:text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <input
        x-ref="searchInput"
        type="text"
        x-model="query"
        @input="runSearch()"
        placeholder="<%= placeholder %>"
        class="input w-full pl-10 pr-4 py-3 border-0 rounded-none bg-transparent focus:ring-0 text-stone-800 dark:text-white/90 placeholder-stone-400 dark:placeholder-white/50"
        autocomplete="off"
        aria-label="Search"
      />
      <span class="absolute right-3 top-1/2 -translate-y-1/2 hidden sm:inline text-xs text-stone-400 dark:text-white/40">Esc to close</span>
    </div>

    <div class="max-h-[60vh] overflow-y-auto py-2">
      <template x-if="loading">
        <div class="px-4 py-6 text-center text-sm text-stone-500 dark:text-white/50">Searching...</div>
      </template>
      <template x-if="!loading && query.length > 0 && items.length === 0">
        <div class="px-4 py-6 text-center text-sm text-stone-500 dark:text-white/50">No results found.</div>
      </template>
      <template x-if="!loading && query.length === 0 && items.length === 0">
        <div class="px-4 py-6 text-center text-sm text-stone-500 dark:text-white/50">Type to search or filter actions.</div>
      </template>
      <template x-if="!loading && items.length > 0">
        <ul class="py-1" role="listbox">
          <template x-for="(item, index) in items" :key="index">
            <li>
              <button
                type="button"
                @click="selectResult(item)"
                :class="index === selectedIndex ? 'bg-stone-100 dark:bg-white/10' : ''"
                class="w-full text-left px-4 py-2.5 flex items-center gap-3 hover:bg-stone-50 dark:hover:bg-white/5 transition-colors"
                role="option"
                :aria-selected="index === selectedIndex"
              >
                <span
                  x-text="typeBadge(item.type)"
                  :class="{
                    'bg-accent-100 dark:bg-accent-900/30 text-accent-700 dark:text-accent-300': item.type === 'feature',
                    'bg-info-100 dark:bg-info-900/30 text-info-700 dark:text-info-300': item.type === 'scenario',
                    'bg-success-100 dark:bg-success-900/30 text-success-700 dark:text-success-300': item.type === 'command',
                    'bg-stone-100 dark:bg-white/10 text-stone-600 dark:text-white/70': item.type === 'nav'
                  }"
                  class="shrink-0 text-xs font-medium px-2 py-0.5 rounded"
                ></span>
                <span class="min-w-0 flex-1">
                  <span class="block text-sm font-medium text-stone-800 dark:text-white/90 truncate" x-text="item.title"></span>
                  <span class="flex items-center gap-2 flex-wrap">
                    <span class="text-xs text-stone-500 dark:text-white/50 truncate" x-text="item.subtitle"></span>
                    <span
                      x-show="item.status"
                      x-text="item.status_label"
                      :class="{
                        'bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300': item.status === 'passed',
                        'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300': item.status === 'failed',
                        'bg-stone-100 dark:bg-white/10 text-stone-600 dark:text-white/60': item.status === 'pending'
                      }"
                      class="shrink-0 text-xs font-medium px-1.5 py-0.5 rounded"
                    ></span>
                  </span>
                </span>
                <kbd x-show="item.shortcut" x-text="item.shortcut" class="shrink-0 text-xs font-medium px-1.5 py-0.5 rounded border border-stone-200 dark:border-white/20 text-stone-600 dark:text-white/60"></kbd>
              </button>
            </li>
          </template>
        </ul>
      </template>
    </div>

    <div x-show="metaShortcuts && metaShortcuts.length" class="border-t border-stone-100 dark:border-white/10 px-4 py-2 flex items-center gap-3 text-xs text-stone-500 dark:text-white/50">
      <template x-for="(s, i) in metaShortcuts" :key="i">
        <span class="flex items-center gap-1.5">
          <kbd class="font-medium px-1.5 py-0.5 rounded border border-stone-200 dark:border-white/20 text-stone-600 dark:text-white/60" x-text="s.keys"></kbd>
          <span x-text="s.label"></span>
          <span x-show="i < metaShortcuts.length - 1" class="text-stone-300 dark:text-white/30">·</span>
        </span>
      </template>
    </div>
  </div>
</div>
