<div
  x-data="{
    title: <%= field_value.to_json %>,
    updateTitle(event) {
      this.title = event.target.innerText.trim();
      setTimeout(() => {
        htmx.trigger(event.target, 'save-title');
      }, 10);
    }
  }"
>
  <form id="<%= form_id %>" style="display: none;">
    <input type="hidden" name="feature[title]" x-bind:value="title">
  </form>
  <h1
    class="text-4xl font-bold tracking-tight mb-1 text-stone-800 dark:text-white/90 is-editable"
    style="letter-spacing: -0.02em;"
    contenteditable="true"
    x-on:blur="updateTitle($event)"
    hx-patch="<%= update_path %>"
    hx-trigger="save-title"
    hx-include="#<%= form_id %>"
    hx-target="closest [data-feature-header]"
    hx-swap="outerHTML"
  ><%= feature.title %></h1>
</div>
