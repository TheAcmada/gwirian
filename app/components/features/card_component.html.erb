<div class="relative group">
  <% if helpers.can?(:destroy, feature) %>
    <%= render Features::DropdownMenuComponent.new(feature: feature, project: project) %>
  <% end %>
  <%= link_to project_feature_path(project, feature), class: "block" do %>
    <div class="p-4 rounded transition-colors duration-75 hover:bg-stone-50 dark:hover:bg-white/5 border border-stone-200 dark:border-white/10">
      <h3 class="text-sm font-medium mb-1 text-stone-800 dark:text-white/90 group-hover:underline">
        <%= feature.title %>
      </h3>
      <% if feature.description.present? %>
        <p class="text-sm line-clamp-2 mb-3 text-stone-500 dark:text-white/60">
          <%= feature.description %>
        </p>
      <% else %>
        <p class="text-sm italic mb-3 text-stone-400 dark:text-white/30">
          No description
        </p>
      <% end %>
      <%= render ::Tags::ListComponent.new(tags: feature.tags) %>
      <div class="mt-3 flex items-center text-xs text-stone-400 dark:text-white/40">
        <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        <span><%= feature.created_at.strftime("%b %d, %Y") %></span>
      </div>
    </div>
  <% end %>
</div>
