<div class="relative group">
  <% if helpers.can?(:destroy, feature) %>
    <%= render Features::DropdownMenuComponent.new(feature: feature, project: project) %>
  <% end %>
  <%= link_to project_feature_path(project, feature), class: "block" do %>
    <div class="p-4 rounded-lg transition-all duration-150 hover:bg-stone-50 dark:hover:bg-white/5 border border-stone-200 dark:border-white/10 hover:border-stone-300 dark:hover:border-white/20 hover:shadow-sm">
      <h3 class="text-sm font-semibold mb-1 text-stone-800 dark:text-white/90 group-hover:text-stone-900 dark:group-hover:text-white transition-colors">
        <%= feature.title %>
      </h3>
      <% if feature.description.present? %>
        <p class="text-sm line-clamp-2 mb-3 text-stone-500 dark:text-white/60">
          <%= feature.description %>
        </p>
      <% else %>
        <p class="text-sm italic mb-3 text-stone-400 dark:text-white/30">
          No description
        </p>
      <% end %>

      <%= render ::Tags::ListComponent.new(tags: feature.tags) %>

      <%# Execution statistics %>
      <% if has_scenarios? %>
        <div class="mt-4 pt-3 border-t border-stone-100 dark:border-white/5">
          <div class="text-xs text-stone-600 dark:text-white/70 mb-2">
            <%= scenarios_count %> <%= "scenario".pluralize(scenarios_count) %>
          </div>

          <%# Progress bar %>
          <div class="h-2 w-full bg-stone-100 dark:bg-white/10 rounded-full overflow-hidden flex mb-2">
            <% if passed_percentage > 0 %>
              <div class="h-full bg-emerald-500" style="width: <%= passed_percentage %>%"></div>
            <% end %>
            <% if failed_percentage > 0 %>
              <div class="h-full bg-red-500" style="width: <%= failed_percentage %>%"></div>
            <% end %>
            <% if pending_percentage > 0 %>
              <div class="h-full bg-stone-300 dark:bg-white/30" style="width: <%= pending_percentage %>%"></div>
            <% end %>
          </div>

          <%# Legend %>
          <div class="flex items-center gap-4 text-xs">
            <% if execution_stats[:passed] > 0 %>
              <span class="flex items-center gap-1 text-emerald-600 dark:text-emerald-400">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                <%= execution_stats[:passed] %> Passed
              </span>
            <% end %>
            <% if execution_stats[:failed] > 0 %>
              <span class="flex items-center gap-1 text-red-600 dark:text-red-400">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m9.75 9.75 4.5 4.5m0-4.5-4.5 4.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                <%= execution_stats[:failed] %> Failed
              </span>
            <% end %>
            <% if execution_stats[:pending] > 0 %>
              <span class="flex items-center gap-1 text-stone-500 dark:text-white/50">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                <%= execution_stats[:pending] %> Pending
              </span>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="mt-4 pt-3 border-t border-stone-100 dark:border-white/5">
          <p class="text-xs text-stone-400 dark:text-white/30 italic">No scenarios yet</p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
