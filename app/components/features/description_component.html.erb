<div
  x-data="{
    description: <%= field_value.to_json %>,
    updateDescription(event) {
      let text = event.target.innerText.trim();
      this.description = text === 'Add a description...' ? '' : text;
      setTimeout(() => {
        htmx.trigger(event.target, 'save-description');
      }, 10);
    }
  }"
>
  <form id="<%= form_id %>" style="display: none;">
    <input type="hidden" name="feature[description]" x-bind:value="description">
  </form>
  <% if has_description? %>
    <p
      class="text-base leading-relaxed text-stone-800 dark:text-white/90 is-editable"
      contenteditable="true"
      x-on:blur="updateDescription($event)"
      hx-patch="<%= update_path %>"
      hx-trigger="save-description"
      hx-include="#<%= form_id %>"
      hx-target="closest .mb-8"
      hx-swap="outerHTML"
    ><%= feature.description %></p>
  <% else %>
    <p
      class="text-base text-stone-400 dark:text-white/30 is-editable"
      contenteditable="true"
      x-on:blur="updateDescription($event)"
      hx-patch="<%= update_path %>"
      hx-trigger="save-description"
      hx-include="#<%= form_id %>"
      hx-target="closest .mb-8"
      hx-swap="outerHTML"
    >Add a description...</p>
  <% end %>
</div>
