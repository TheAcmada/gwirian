<div class="card hover:shadow-md transition-shadow relative">
  <!-- Clickable area for edit -->
  <%= link_to edit_project_test_case_path(project, test_case), class: "block absolute inset-0 z-10" do %>
    <span class="sr-only">Edit <%= test_case.title %></span>
  <% end %>

  <!-- Header -->
  <div class="mb-3">
    <h3 class="text-lg font-semibold text-zinc-900 dark:text-white line-clamp-2 mb-3">
      <%= test_case.title %>
    </h3>

    <!-- Status, Priority, and Step Count -->
    <div class="flex items-center space-x-2">
      <span class="badge badge-sm <%= status_badge_class %>">
        <%= test_case.status.humanize %>
      </span>
      <span class="badge badge-sm <%= priority_badge_class %>">
        <%= test_case.priority.humanize %>
      </span>
      <div class="flex items-center text-sm text-zinc-500 dark:text-gray-400">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
        </svg>
        <%= pluralize(test_case.test_steps.count, 'step') %>
      </div>
    </div>
  </div>

  <!-- Description -->
  <% if test_case.description.present? %>
    <p class="text-sm text-zinc-600 dark:text-gray-300 mb-3 line-clamp-3">
      <%= test_case.description %>
    </p>
  <% end %>

  <!-- Tags -->
  <% if test_case.tag_list.any? %>
    <div class="mb-4">
      <div class="flex flex-wrap gap-1">
        <% test_case.tag_list.each do |tag| %>
          <span class="badge badge-sm badge-accent">
            <%= tag %>
          </span>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Actions -->
  <div class="flex items-center justify-end relative z-20">
    <% if deletable %>
      <%= link_to project_test_case_path(project, test_case),
          method: :delete,
          data: { confirm: "Are you sure you want to delete this test case?" },
          class: "btn btn-sm btn-danger" do %>
        Delete
      <% end %>
    <% end %>
  </div>
</div>
