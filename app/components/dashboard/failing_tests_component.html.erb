<div class="bg-white dark:bg-stone-900 rounded-xl border border-stone-200 dark:border-stone-800 overflow-hidden">
  <div class="px-5 py-4 border-b border-stone-200 dark:border-stone-800">
    <h3 class="text-sm font-semibold text-stone-900 dark:text-white flex items-center gap-2">
      <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
      </svg>
      <%= t("dashboard.failing_tests.title") %>
    </h3>
  </div>

  <% if has_failures? %>
    <div class="divide-y divide-stone-100 dark:divide-stone-800">
      <% failing_scenarios.each do |scenario| %>
        <%= render Shared::AlertItemComponent.new(
          title: scenario.title,
          description: scenario.feature.title,
          severity: :critical,
          link: scenario_link(scenario),
          timestamp: last_execution_time(scenario)
        ) %>
      <% end %>
    </div>
  <% else %>
    <div class="px-5 py-12 text-center">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-emerald-100 dark:bg-emerald-900/30 mb-3">
        <svg class="w-6 h-6 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
      <p class="text-sm text-stone-500 dark:text-stone-400">
        <%= t("dashboard.failing_tests.all_passing") %>
      </p>
    </div>
  <% end %>
</div>

