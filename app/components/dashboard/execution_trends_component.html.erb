<div class="bg-white dark:bg-stone-900 rounded-xl border border-stone-200 dark:border-stone-800 overflow-hidden">
  <div class="px-5 py-4 border-b border-stone-200 dark:border-stone-800 flex items-center justify-between">
    <h3 class="text-sm font-semibold text-stone-900 dark:text-white flex items-center gap-2">
      <svg class="w-4 h-4 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/>
      </svg>
      <%= t("dashboard.execution_trends.title") %>
    </h3>
    <div class="flex items-center gap-4 text-xs text-stone-500 dark:text-stone-400">
      <span><%= t("dashboard.execution_trends.total") %>: <strong class="text-stone-700 dark:text-stone-200"><%= total_executions %></strong></span>
      <span><%= t("dashboard.execution_trends.avg_pass_rate") %>: <strong class="text-stone-700 dark:text-stone-200"><%= avg_pass_rate %>%</strong></span>
    </div>
  </div>

  <% if has_data? %>
    <div
      x-data='{
        chart: null,
        chartData: <%= raw chart_data_json %>,
        async initChart() {
          const echarts = await import("echarts");
          this.chart = echarts.init(this.$refs.chart);
          const isDark = document.documentElement.classList.contains("dark");
          const textColor = isDark ? "#a8a29e" : "#78716c";
          const gridColor = isDark ? "#44403c" : "#e7e5e4";
          const option = {
            tooltip: {
              trigger: "axis",
              backgroundColor: isDark ? "#1c1917" : "#ffffff",
              borderColor: isDark ? "#44403c" : "#e7e5e4",
              textStyle: { color: isDark ? "#fafaf9" : "#1c1917" }
            },
            legend: {
              data: ["Executions", "Pass Rate %"],
              textStyle: { color: textColor },
              bottom: 0
            },
            grid: {
              left: "3%",
              right: "4%",
              bottom: "15%",
              top: "3%",
              containLabel: true
            },
            xAxis: {
              type: "category",
              boundaryGap: false,
              data: this.chartData.dates,
              axisLine: { lineStyle: { color: gridColor } },
              axisLabel: { color: textColor, fontSize: 10 }
            },
            yAxis: [
              {
                type: "value",
                name: "Executions",
                nameTextStyle: { color: textColor },
                axisLine: { lineStyle: { color: gridColor } },
                axisLabel: { color: textColor },
                splitLine: { lineStyle: { color: gridColor } }
              },
              {
                type: "value",
                name: "Pass Rate %",
                nameTextStyle: { color: textColor },
                min: 0,
                max: 100,
                axisLine: { lineStyle: { color: gridColor } },
                axisLabel: { color: textColor, formatter: "{value}%" },
                splitLine: { show: false }
              }
            ],
            series: [
              {
                name: "Executions",
                type: "bar",
                data: this.chartData.executions,
                itemStyle: { color: "#a8a29e", borderRadius: [4, 4, 0, 0] }
              },
              {
                name: "Pass Rate %",
                type: "line",
                yAxisIndex: 1,
                data: this.chartData.pass_rates,
                smooth: true,
                symbol: "circle",
                symbolSize: 6,
                lineStyle: { color: "#10b981", width: 2 },
                itemStyle: { color: "#10b981" },
                connectNulls: true
              }
            ]
          };
          this.chart.setOption(option);
          window.addEventListener("resize", () => this.chart.resize());
        }
      }'
      x-init="initChart()"
      class="p-4"
    >
      <div x-ref="chart" class="w-full h-64"></div>
    </div>
  <% else %>
    <div class="px-5 py-12 text-center">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-stone-100 dark:bg-stone-800 mb-3">
        <svg class="w-6 h-6 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
        </svg>
      </div>
      <p class="text-sm text-stone-500 dark:text-stone-400">
        <%= t("dashboard.execution_trends.no_data") %>
      </p>
    </div>
  <% end %>
</div>

