<div id="<%= form_id %>">
  <% if api_token_valid? %>
    <div class="mb-4">
      <label class="block text-sm font-medium mb-1 text-stone-800 dark:text-white/90">Your API Token</label>
      <div class="flex items-center gap-2">
        <input class="input flex-1" type="text" value="<%= api_token %>" readonly>
        <button type="button"
                class="btn"
                title="Copy to clipboard"
                x-data="{ copied: false }"
                @click="
                  navigator.clipboard.writeText('<%= api_token %>').then(() => {
                    copied = true;
                    showNotice('API token copied to clipboard');
                    setTimeout(() => copied = false, 2000);
                  }).catch(() => {
                    showError('Failed to copy to clipboard');
                  });
                ">
          <svg x-show="!copied" class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
          </svg>
          <svg x-show="copied" class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 6L9 17l-5-5"/>
          </svg>
        </button>
      </div>
      <p class="mt-1 text-xs text-stone-400 dark:text-white/40">Expires: <%= l(api_token_expires_at, format: :long) %></p>
      <p class="mt-1 text-xs text-stone-400 dark:text-white/40">Workspace: <%= workspace_name %></p>
    </div>
    <div class="flex justify-end gap-2">
      <%= button_to "Revoke Token",
                    revoke_api_token_path,
                    method: :delete,
                    form: { "hx-delete": revoke_api_token_path, "hx-target": "##{form_id}", "hx-swap": "outerHTML" },
                    class: "btn btn-danger" %>
    </div>
  <% else %>
    <%= form_with url: generate_api_token_path,
                  method: :post,
                  html: {
                    "hx-post": generate_api_token_path,
                    "hx-target": "##{form_id}",
                    "hx-swap": "outerHTML"
                  } do |form| %>
      <div class="mb-4">
        <%= form.label :expires_in, "Token Expiration", class: 'block text-sm font-medium mb-1 text-stone-800 dark:text-white/90' %>
        <%= form.select :expires_in,
            options_for_select(expiration_options),
            {},
            class: "input" %>
      </div>
      <div class="flex justify-end gap-2">
        <%= form.submit "Generate API Token", class: "btn btn-primary" %>
      </div>
    <% end %>
  <% end %>
</div>
