<div class="bg-white dark:bg-stone-900 rounded-xl border border-stone-200 dark:border-stone-800 overflow-hidden">
  <% if has_executions? %>
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead>
          <tr class="border-b border-stone-200 dark:border-stone-800">
            <th class="px-6 py-3 text-left text-xs font-medium text-stone-500 dark:text-stone-400 uppercase tracking-wider">
              Feature Name
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-stone-500 dark:text-stone-400 uppercase tracking-wider">
              Scenario
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-stone-500 dark:text-stone-400 uppercase tracking-wider">
              Status
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-stone-500 dark:text-stone-400 uppercase tracking-wider">
              Run by
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-stone-500 dark:text-stone-400 uppercase tracking-wider">
              Executed at
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-stone-500 dark:text-stone-400 uppercase tracking-wider">
              Notes
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-stone-500 dark:text-stone-400 uppercase tracking-wider">
              Tags
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100 dark:divide-stone-800">
          <% executions.each do |execution| %>
            <tr class="hover:bg-stone-50 dark:hover:bg-stone-800/50 transition-colors">
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="text-sm font-medium text-stone-900 dark:text-white">
                  <%= execution.scenario.feature.title %>
                </span>
              </td>
              <td class="px-6 py-4">
                <a href="<%= scenario_link(execution) %>" class="text-sm text-stone-700 dark:text-stone-300 hover:text-stone-900 dark:hover:text-white hover:underline">
                  <%= execution.scenario.title %>
                </a>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <%= render Shared::StatusComponent.new(status: execution.status, variant: :badge) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="text-sm text-stone-600 dark:text-stone-400">
                  <%= executor_name(execution) %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="text-sm text-stone-500 dark:text-stone-400">
                  <%= formatted_timestamp(execution) %>
                </span>
              </td>
              <td class="px-6 py-4">
                <% if execution.notes.present? %>
                  <span class="text-sm text-stone-600 dark:text-stone-400 line-clamp-2 max-w-xs" title="<%= execution.notes %>">
                    <%= execution.notes %>
                  </span>
                <% else %>
                  <span class="text-sm text-stone-400 dark:text-stone-500">—</span>
                <% end %>
              </td>
              <td class="px-6 py-4">
                <% if execution.tag_list.present? %>
                  <div class="flex flex-wrap gap-1">
                    <% execution.tag_list.each do |tag| %>
                      <span class="badge badge-sm <%= tag_color_class(tag) %>"><%= tag %></span>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-sm text-stone-400 dark:text-stone-500">—</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="px-6 py-16 text-center">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-stone-100 dark:bg-stone-800 mb-4">
        <svg class="w-6 h-6 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <h3 class="text-sm font-medium text-stone-900 dark:text-white mb-1">No execution history</h3>
      <p class="text-sm text-stone-500 dark:text-stone-400">
        Test executions will appear here once you start running scenarios.
      </p>
    </div>
  <% end %>
</div>

