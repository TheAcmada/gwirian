<div
  class="scenario-item group p-4 bg-white dark:bg-gray-800 rounded-lg border border-zinc-200 dark:border-gray-700"
  x-data="{ expanded: false }"
  data-id="<%= scenario.id %>"
>
  <div class="flex items-center gap-2 mb-2">
    <% if helpers.can?(:update, scenario) %>
      <span class="drag-handle opacity-0 group-hover:opacity-100 cursor-grab active:cursor-grabbing text-zinc-400 dark:text-gray-500 hover:text-zinc-600 dark:hover:text-gray-400 transition-opacity" title="Drag to reorder">
        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="12" r="1"/>
          <circle cx="9" cy="5" r="1"/>
          <circle cx="9" cy="19" r="1"/>
          <circle cx="15" cy="12" r="1"/>
          <circle cx="15" cy="5" r="1"/>
          <circle cx="15" cy="19" r="1"/>
        </svg>
      </span>
    <% end %>
    <button
      type="button"
      @click="expanded = !expanded"
      class="text-zinc-500 cursor-pointer dark:text-gray-400 hover:text-zinc-700 dark:hover:text-gray-200 transition-colors"
      aria-label="Toggle scenario details"
    >
      <svg
        class="w-5 h-5 transition-transform"
        :class="{ 'rotate-90': expanded }"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>
    <%= render ScenarioTitleComponent.new(scenario: scenario, feature: feature, project: project) %>
  </div>

  <div
    x-show="expanded"
    x-transition
    class="mt-3 space-y-3"
    style="display: none;"
  >
    <% if scenario.given.present? || scenario[:when].present? || scenario[:then].present? %>
      <div class="space-y-2 text-sm text-zinc-600 dark:text-gray-300">
        <% if scenario.given.present? %>
          <div>
            <span class="font-semibold text-zinc-800 dark:text-gray-200">Given:</span>
            <span class="ml-2"><%= scenario.given %></span>
          </div>
        <% end %>
        <% if scenario[:when].present? %>
          <div>
            <span class="font-semibold text-zinc-800 dark:text-gray-200">When:</span>
            <span class="ml-2"><%= scenario[:when] %></span>
          </div>
        <% end %>
        <% if scenario[:then].present? %>
          <div>
            <span class="font-semibold text-zinc-800 dark:text-gray-200">Then:</span>
            <span class="ml-2"><%= scenario[:then] %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-zinc-400 dark:text-gray-500 italic">No details provided</p>
    <% end %>
  </div>
</div>

