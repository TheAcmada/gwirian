<div style="max-width: 480px; margin: 0 auto; background: #fff; border-radius: 8px; box-shadow: 0 2px 8px #e5e7eb; padding: 32px 24px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
  <%= render partial: 'shared/email_header' %>

  <div style="text-align: center; margin-bottom: 24px;">
    <h1 style="font-size: 1.5rem; font-weight: 700; color: #1e293b; margin: 0;">Welcome to Gwirian</h1>
  </div>

  <p style="font-size: 1.1rem; color: #334155; margin-bottom: 16px;">Hello!</p>

  <p style="color: #334155; margin-bottom: 16px;">Your account has been created. We've sent you a separate email with a sign-in link so you can access Gwirian.</p>

  <p style="color: #334155; margin-bottom: 24px;">Once you're in, you can create workspaces, add projects, and start collaborating with your team.</p>

  <%= render partial: 'shared/email_button', locals: { url: root_url, text: 'Go to Gwirian' } %>

  <%= render partial: 'shared/email_footer' %>
</div>
