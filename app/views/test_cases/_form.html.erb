<%= form_with model: [@project, test_case], local: true,
    data: {
      controller: "test-case-form",
      "test-case-form-steps-value": test_case.test_steps.map { |step|
        { id: step.id, position: step.position, action: step.action, expected_result: step.expected_result, _destroy: false }
      }.to_json
    } do |f| %>

  <%= render 'shared/errors', model: test_case %>

  <!-- Basic Fields -->
  <div class="mb-6">
    <div class="mb-4">
      <%= f.label :title, "Title", class: 'label' %>
      <%= f.text_field :title, class: 'input', placeholder: "Enter test case title", autofocus: true %>
    </div>

    <div class="mb-4">
      <%= f.label :description, "Description", class: 'label' %>
      <%= f.text_area :description, class: 'input h-24', placeholder: "Enter test case description" %>
      <p class="mt-1 text-xs text-gray-400">Optional</p>
    </div>

    <div class="mb-4">
      <%= f.label :preconditions, "Preconditions", class: 'label' %>
      <%= f.text_area :preconditions, class: 'input h-20', placeholder: "Any setup required before testing" %>
      <p class="mt-1 text-xs text-gray-400">Optional</p>
    </div>

    <div class="mb-4">
      <%= f.label :expected_result, "Expected Result", class: 'label' %>
      <%= f.text_area :expected_result, class: 'input h-20', placeholder: "What should happen when this test passes" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
      <div>
        <%= f.label :priority, "Priority", class: 'label' %>
        <%= f.select :priority,
            options_for_select([
              ['Low', 'low'],
              ['Medium', 'medium'],
              ['High', 'high'],
              ['Critical', 'critical']
            ], test_case.priority),
            {},
            { class: 'input' } %>
      </div>
      <div>
        <%= f.label :status, "Status", class: 'label' %>
        <%= f.select :status,
            options_for_select([
              ['Draft', 'draft'],
              ['Active', 'active'],
              ['Deprecated', 'deprecated']
            ], test_case.status),
            {},
            { class: 'input' } %>
      </div>
    </div>

    <div class="mb-4">
      <%= f.label :category, "Category", class: 'label' %>
      <%= f.text_field :category, class: 'input', placeholder: "e.g., feature, regression, smoke, integration" %>
      <p class="mt-1 text-xs text-gray-400">Optional</p>
    </div>

    <div class="mb-6">
      <%= f.label :tag_list, "Tags", class: 'label' %>
      <%= f.text_field :tag_list, class: 'input', placeholder: "Enter tags separated by commas (e.g., browser, api, mobile)" %>
      <p class="mt-1 text-xs text-gray-400">Separate multiple tags with commas</p>
    </div>
  </div>

  <!-- Test Steps Section -->
  <div class="mb-6"
       x-data="{
         steps: <%= test_case.test_steps.map { |step|
           { id: step.id, position: step.position, action: step.action, expected_result: step.expected_result, _destroy: false }
         }.to_json %>,
         nextPosition: <%= test_case.test_steps.maximum(:position).to_i + 1 %>,
         addStep() {
           this.steps.push({
             id: null,
             position: this.nextPosition++,
             action: '',
             expected_result: '',
             _destroy: false
           });
         },
         removeStep(index) {
           if (this.steps[index].id) {
             this.steps[index]._destroy = true;
           } else {
             this.steps.splice(index, 1);
           }
         },
         moveUp(index) {
           if (index > 0) {
             const temp = this.steps[index];
             this.steps[index] = this.steps[index - 1];
             this.steps[index - 1] = temp;
             this.updatePositions();
           }
         },
         moveDown(index) {
           if (index < this.steps.length - 1) {
             const temp = this.steps[index];
             this.steps[index] = this.steps[index + 1];
             this.steps[index + 1] = temp;
             this.updatePositions();
           }
         },
         updatePositions() {
           this.steps.forEach((step, index) => {
             step.position = index + 1;
           });
         }
       }">

    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-semibold text-zinc-900 dark:text-white">Test Steps</h3>
      <button type="button" @click="addStep()" class="btn btn-sm btn-primary">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        Add Step
      </button>
    </div>

    <div class="space-y-4" x-show="steps.length > 0">
      <template x-for="(step, index) in steps" :key="index">
        <div class="border border-zinc-200 dark:border-gray-700 rounded-lg p-4"
             x-show="!step._destroy">

          <!-- Step Header -->
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center space-x-3">
              <span class="flex-shrink-0 w-8 h-8 bg-accent-100 dark:bg-accent-900 text-accent-600 dark:text-accent-400 rounded-full flex items-center justify-center text-sm font-semibold"
                    x-text="step.position"></span>
              <span class="text-sm font-medium text-zinc-700 dark:text-gray-300">Step <span x-text="step.position"></span></span>
            </div>
            <div class="flex items-center space-x-2">
              <!-- Move Up/Down Buttons -->
              <button type="button" @click="moveUp(index)"
                      :disabled="index === 0"
                      class="btn btn-sm btn-ghost"
                      :class="{ 'opacity-50 cursor-not-allowed': index === 0 }">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
                </svg>
              </button>
              <button type="button" @click="moveDown(index)"
                      :disabled="index === steps.length - 1"
                      class="btn btn-sm btn-ghost"
                      :class="{ 'opacity-50 cursor-not-allowed': index === steps.length - 1 }">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <!-- Remove Button -->
              <button type="button" @click="removeStep(index)"
                      class="btn btn-sm btn-danger">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              </button>
            </div>
          </div>

          <!-- Hidden Fields for Rails -->
          <input type="hidden" :name="`test_case[test_steps_attributes][${index}][id]`" :value="step.id">
          <input type="hidden" :name="`test_case[test_steps_attributes][${index}][position]`" :value="step.position">
          <input type="hidden" :name="`test_case[test_steps_attributes][${index}][_destroy]`" :value="step._destroy">

          <!-- Step Fields -->
          <div class="space-y-3">
            <div>
              <label class="label">Action</label>
              <textarea :name="`test_case[test_steps_attributes][${index}][action]`"
                        x-model="step.action"
                        class="input h-20"
                        placeholder="What action should be performed in this step"
                        required></textarea>
            </div>
            <div>
              <label class="label">Expected Result</label>
              <textarea :name="`test_case[test_steps_attributes][${index}][expected_result]`"
                        x-model="step.expected_result"
                        class="input h-16"
                        placeholder="What should happen as a result of this action (optional)"></textarea>
            </div>
          </div>
        </div>
      </template>
    </div>

    <!-- Empty Steps State -->
    <div class="text-center py-8 border-2 border-dashed border-zinc-200 dark:border-gray-700 rounded-lg"
         x-show="steps.length === 0">
      <svg class="w-12 h-12 text-zinc-400 dark:text-gray-500 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
      </svg>
      <p class="text-zinc-500 dark:text-gray-400 mb-2">No test steps defined</p>
      <p class="text-sm text-zinc-400 dark:text-gray-500 mb-4">Add steps to define the test execution flow</p>
      <button type="button" @click="addStep()" class="btn btn-primary">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        Add First Step
      </button>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="flex justify-end gap-2">
    <%= link_to project_test_cases_path(@project), class: 'btn' do %>
      Cancel
    <% end %>
    <%= f.submit test_case.persisted? ? "Update Test Case" : "Create Test Case", class: 'btn btn-primary' %>
  </div>
<% end %>
