<% content_for :title, "#{@project.name} - Test Cases" %>

<div class="max-w-5xl mx-auto px-4 py-8">
  <!-- Page Header -->
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="title">Test Cases</h1>
      <p class="text-zinc-600 dark:text-gray-300 mt-1">Manage test cases for <%= @project.name %></p>
    </div>
    <% if can? :create, @project.test_cases.build %>
      <%= link_to new_project_test_case_path(@project), class: "btn btn-primary inline-flex items-center" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        New Test Case
      <% end %>
    <% end %>
  </div>

  <!-- Filters Section -->
  <div class="card mb-6">
    <h2 class="text-lg font-semibold text-zinc-900 dark:text-white mb-4">Filters</h2>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div>
        <label class="label">Priority</label>
        <select class="input">
          <option value="">All Priorities</option>
          <option value="critical">Critical</option>
          <option value="high">High</option>
          <option value="medium">Medium</option>
          <option value="low">Low</option>
        </select>
      </div>
      <div>
        <label class="label">Status</label>
        <select class="input">
          <option value="">All Statuses</option>
          <option value="active">Active</option>
          <option value="draft">Draft</option>
          <option value="deprecated">Deprecated</option>
        </select>
      </div>
      <div>
        <label class="label">Category</label>
        <input type="text" class="input" placeholder="Filter by category">
      </div>
      <div>
        <label class="label">Tags</label>
        <input type="text" class="input" placeholder="Filter by tags">
      </div>
    </div>
  </div>

  <!-- Test Cases Grid -->
  <% if @test_cases.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      <% @test_cases.each do |test_case| %>
        <%= render TestCaseCardComponent.new(test_case: test_case, project: @project, deletable: can?(:destroy, test_case)) %>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="flex flex-col items-center justify-center py-24">
      <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-list text-zinc-400 dark:text-gray-500">
        <rect width="8" height="4" x="8" y="2" rx="1" ry="1"/>
        <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
        <path d="M12 11h4"/>
        <path d="M12 16h4"/>
        <path d="M8 11h.01"/>
        <path d="M8 16h.01"/>
      </svg>
      <p class="text-lg text-zinc-500 dark:text-gray-400 mb-2">No test cases yet</p>
      <p class="text-sm text-zinc-400 dark:text-gray-500 mb-4">Create your first test case to get started</p>
      <% if can? :create, @project.test_cases.build %>
        <%= link_to new_project_test_case_path(@project), class: "btn btn-primary inline-flex items-center" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Create your first test case
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
