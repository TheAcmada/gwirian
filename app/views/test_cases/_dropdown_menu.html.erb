<div class="relative" x-data="{ open: false }">
  <button
    type="button"
    class="absolute top-0 right-0 mt-2 mr-2 flex items-center justify-center w-8 h-8 rounded-full cursor-pointer hover:bg-zinc-100 dark:hover:bg-gray-700 focus:outline-none focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-accent-500"
    aria-label="Open menu"
    @click="open = !open"
    @keydown.escape.window="open = false"
  >
    <svg class="size-5 text-zinc-500 z-10 dark:text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/></svg>
  </button>
  <div
    x-show="open"
    @click.outside="open = false"
    x-transition
    class="absolute right-0 mt-12 mr-2 z-10 bg-white dark:bg-gray-800 border border-zinc-200 dark:border-gray-700 rounded-lg shadow-lg py-1 focus:outline-none"
    style="display: none;"
    role="menu"
    aria-orientation="vertical"
    aria-label="Test case actions menu"
  >
    <%= link_to project_test_case_path(project, test_case),
        method: :delete,
        data: { confirm: "Are you sure you want to delete this test case?" },
        class: "w-full text-left px-4 py-2 text-sm text-error-600 hover:bg-error-50 dark:text-error-300 dark:hover:bg-gray-700 flex items-center gap-2 rounded-md focus-visible:ring-3 focus-visible:ring-error-500",
        role: "menuitem" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
      </svg>
      Delete
    <% end %>
  </div>
</div>
