<% content_for :title, @test_case.title %>

<div class="max-w-4xl mx-auto px-4 py-8">
  <!-- Breadcrumb Navigation -->
  <nav class="flex items-center space-x-2 text-sm text-zinc-500 dark:text-gray-400 mb-6">
    <%= link_to "Projects", projects_path, class: "hover:text-zinc-700 dark:hover:text-gray-200" %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
    </svg>
    <%= link_to @project.name, project_path(@project), class: "hover:text-zinc-700 dark:hover:text-gray-200" %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
    </svg>
    <%= link_to "Test Cases", project_test_cases_path(@project), class: "hover:text-zinc-700 dark:hover:text-gray-200" %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
    </svg>
    <span class="text-zinc-900 dark:text-white"><%= @test_case.title %></span>
  </nav>

  <!-- Test Case Header -->
  <div class="flex items-start justify-between mb-8">
    <div>
      <h1 class="title mb-2"><%= @test_case.title %></h1>
      <div class="flex items-center space-x-3">
        <span class="badge <%= case @test_case.priority
          when 'critical' then 'badge-error'
          when 'high' then 'badge-warning'
          when 'medium' then 'badge-info'
          else 'badge-neutral'
          end %>">
          <%= @test_case.priority.humanize %> Priority
        </span>
        <span class="badge <%= case @test_case.status
          when 'active' then 'badge-success'
          when 'deprecated' then 'badge-warning'
          else 'badge-neutral'
          end %>">
          <%= @test_case.status.humanize %>
        </span>
        <% if @test_case.category.present? %>
          <span class="badge badge-neutral">
            <%= @test_case.category %>
          </span>
        <% end %>
      </div>
    </div>
    <div class="flex items-center space-x-2">
      <% if can? :update, @test_case %>
        <%= link_to edit_project_test_case_path(@project, @test_case), class: "btn" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Edit
        <% end %>
      <% end %>
      <% if can? :destroy, @test_case %>
        <%= link_to project_test_case_path(@project, @test_case),
            method: :delete,
            data: { confirm: "Are you sure you want to delete this test case?" },
            class: "btn btn-danger" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
          Delete
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Test Case Details -->
  <div class="card mb-6">
    <h2 class="text-lg font-semibold text-zinc-900 dark:text-white mb-4">Test Case Details</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Description -->
      <% if @test_case.description.present? %>
        <div class="md:col-span-2">
          <h3 class="text-sm font-medium text-zinc-500 dark:text-gray-400 uppercase tracking-wide mb-2">Description</h3>
          <p class="text-zinc-900 dark:text-white leading-relaxed"><%= @test_case.description %></p>
        </div>
      <% end %>

      <!-- Preconditions -->
      <% if @test_case.preconditions.present? %>
        <div class="md:col-span-2">
          <h3 class="text-sm font-medium text-zinc-500 dark:text-gray-400 uppercase tracking-wide mb-2">Preconditions</h3>
          <p class="text-zinc-900 dark:text-white leading-relaxed"><%= @test_case.preconditions %></p>
        </div>
      <% end %>

      <!-- Expected Result -->
      <div class="md:col-span-2">
        <h3 class="text-sm font-medium text-zinc-500 dark:text-gray-400 uppercase tracking-wide mb-2">Expected Result</h3>
        <p class="text-zinc-900 dark:text-white leading-relaxed"><%= @test_case.expected_result %></p>
      </div>

      <!-- Tags -->
      <% if @test_case.tag_list.any? %>
        <div class="md:col-span-2">
          <h3 class="text-sm font-medium text-zinc-500 dark:text-gray-400 uppercase tracking-wide mb-2">Tags</h3>
          <div class="flex flex-wrap gap-2">
            <% @test_case.tag_list.each do |tag| %>
              <span class="badge badge-accent">
                <%= tag %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Timestamps -->
      <div>
        <h3 class="text-sm font-medium text-zinc-500 dark:text-gray-400 uppercase tracking-wide mb-2">Created</h3>
        <p class="text-zinc-900 dark:text-white"><%= @test_case.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
      </div>
      <div>
        <h3 class="text-sm font-medium text-zinc-500 dark:text-gray-400 uppercase tracking-wide mb-2">Last Updated</h3>
        <p class="text-zinc-900 dark:text-white"><%= @test_case.updated_at.strftime("%B %d, %Y at %I:%M %p") %></p>
      </div>
    </div>
  </div>

  <!-- Test Steps -->
  <div class="card">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold text-zinc-900 dark:text-white">Test Steps</h2>
      <span class="text-sm text-zinc-500 dark:text-gray-400">
        <%= pluralize(@test_case.test_steps.count, 'step') %>
      </span>
    </div>

    <% if @test_case.test_steps.any? %>
      <div class="space-y-4">
        <% @test_case.test_steps.each_with_index do |step, index| %>
          <div class="border border-zinc-200 dark:border-gray-700 rounded-lg p-4">
            <div class="flex items-start space-x-4">
              <!-- Step Number -->
              <div class="flex-shrink-0 w-8 h-8 bg-accent-100 dark:bg-accent-900 text-accent-600 dark:text-accent-400 rounded-full flex items-center justify-center text-sm font-semibold">
                <%= step.position %>
              </div>

              <!-- Step Content -->
              <div class="flex-1 min-w-0">
                <h4 class="text-sm font-medium text-zinc-900 dark:text-white mb-2">Action</h4>
                <p class="text-zinc-700 dark:text-gray-300 mb-3 leading-relaxed"><%= step.action %></p>

                <% if step.expected_result.present? %>
                  <h4 class="text-sm font-medium text-zinc-900 dark:text-white mb-2">Expected Result</h4>
                  <p class="text-zinc-700 dark:text-gray-300 leading-relaxed"><%= step.expected_result %></p>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <!-- Empty Steps State -->
      <div class="text-center py-8">
        <svg class="w-12 h-12 text-zinc-400 dark:text-gray-500 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
        </svg>
        <p class="text-zinc-500 dark:text-gray-400 mb-2">No test steps defined</p>
        <p class="text-sm text-zinc-400 dark:text-gray-500">Add steps to define the test execution flow</p>
      </div>
    <% end %>
  </div>
</div>
