<div style="max-width: 480px; margin: 0 auto; background: #fff; border-radius: 8px; box-shadow: 0 2px 8px #e5e7eb; padding: 32px 24px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
  <%= render partial: 'shared/email_header' %>

  <div style="text-align: center; margin-bottom: 24px;">
    <h1 style="font-size: 1.5rem; font-weight: 700; color: #1e293b; margin: 0;">Gwirian verification code</h1>
  </div>

  <p style="font-size: 1.1rem; color: #334155; margin-bottom: 16px;">Hello!</p>

  <p style="color: #334155; margin-bottom: 24px;">Please enter this 6-character verification code on the Gwirian sign-in page:</p>

  <div style="text-align: center; margin: 32px 0; padding: 24px; background: #f8fafc; border-radius: 8px; border: 2px solid #e2e8f0;">
    <p style="font-size: 32px; font-weight: 700; letter-spacing: 8px; color: #1e293b; margin: 0; font-family: 'Courier New', monospace;"><%= @magic_link.code %></p>
  </div>

  <p style="color: #334155; margin-bottom: 16px;">This code will work for <%= distance_of_time_in_words(MagicLink::EXPIRATION_TIME) %>.</p>

  <p style="color: #64748b; font-size: 0.95rem; margin-bottom: 0;">If you didn't request this code, you can safely ignore this email.</p>

  <%= render partial: 'shared/email_footer' %>
</div>
