<!-- Feature Header -->
<div class="mb-6" data-feature-header>
  <div class="flex items-start justify-between gap-4 mb-2">
    <div class="flex-1">
      <%= render Features::TitleComponent.new(feature: @feature, project: @project) %>
    </div>
    <% if can?(:execute, @feature) %>
      <a
        href="<%= start_execution_project_feature_path(@project, @feature) %>"
        class="btn btn-primary"
      >
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        Run
      </a>
    <% end %>
  </div>
  <%= render Features::DescriptionComponent.new(feature: @feature, project: @project) %>
  <div class="mt-3">
    <%= render Features::TagListComponent.new(feature: @feature, project: @project) %>
  </div>
</div>
