<% content_for :title, "Features - #{@project.name}" %>
<div class="max-w-4xl mx-auto px-4 py-8">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="title mb-2">Features</h1>
    <p class="text-lg text-zinc-600 dark:text-gray-300">Manage and track features for <%= @project.name %></p>
  </div>

  <!-- Features List -->
  <% if @features.any? %>
    <div>
      <% @features.each do |feature| %>
        <%= link_to project_feature_path(@project, feature), class: "block" do %>
          <div class="card transition-all duration-200 hover:shadow-md hover:border-zinc-300 dark:hover:border-gray-600 hover:bg-zinc-50/50 dark:hover:bg-gray-700/50 cursor-pointer">
            <div>
              <h3 class="text-lg font-semibold text-zinc-900 dark:text-white mb-2">
                <%= feature.title %>
              </h3>
              <% if feature.description.present? %>
                <p class="text-zinc-600 dark:text-gray-300 leading-relaxed line-clamp-2">
                  <%= feature.description %>
                </p>
              <% else %>
                <p class="text-zinc-500 dark:text-gray-400 italic">No description provided</p>
              <% end %>
              <div class="mt-3 flex items-center text-xs text-zinc-500 dark:text-gray-400">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <span>Created <%= feature.created_at.strftime("%B %d, %Y") %></span>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="flex flex-col items-center justify-center py-24 text-center">
      <div class="mb-6">
        <svg class="w-20 h-20 mx-auto text-zinc-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
      </div>
      <h3 class="text-xl font-medium text-zinc-500 dark:text-gray-400 mb-2">No features yet</h3>
      <p class="text-base text-zinc-400 dark:text-gray-500 max-w-md">Get started by creating your first feature for this project.</p>
    </div>
  <% end %>
</div>
