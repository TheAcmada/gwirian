  <div class="mb-8">
    <h1 class="title mb-2">Features</h1>
    <p class="text-lg text-zinc-600 dark:text-gray-300">Manage and track features for <%= @project.name %></p>
  </div>

  <!-- Features List -->
  <%= render partial: "features/features", locals: { features: @features, project: @project } %>
</div>
