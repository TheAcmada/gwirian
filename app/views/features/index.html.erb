<% content_for :title, "Features - #{@project.name}" %>
<div class="max-w-4xl mx-auto px-4 py-8">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="title mb-2">Features</h1>
    <p class="text-lg text-zinc-600 dark:text-gray-300">Manage and track features for <%= @project.name %></p>
  </div>

  <!-- Features List -->
  <% if @features.any? %>
    <div class="space-y-4">
      <% @features.each do |feature| %>
        <div class="card">
          <%= link_to project_feature_path(@project, feature), class: "block hover:opacity-90 transition-opacity" do %>
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <h3 class="text-lg font-semibold text-zinc-900 dark:text-white mb-2">
                  <%= feature.title %>
                </h3>
                <% if feature.description.present? %>
                  <p class="text-zinc-600 dark:text-gray-300 leading-relaxed line-clamp-2">
                    <%= feature.description %>
                  </p>
                <% else %>
                  <p class="text-zinc-500 dark:text-gray-400 italic">No description provided</p>
                <% end %>
                <div class="mt-3 flex items-center text-xs text-zinc-500 dark:text-gray-400">
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                  <span>Created <%= feature.created_at.strftime("%B %d, %Y") %></span>
                </div>
              </div>
              <div class="ml-4">
                <svg class="w-5 h-5 text-zinc-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="card text-center py-12">
      <svg class="w-16 h-16 mx-auto text-zinc-400 dark:text-gray-500 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <h3 class="text-lg font-semibold text-zinc-900 dark:text-white mb-2">No features yet</h3>
      <p class="text-zinc-600 dark:text-gray-300 mb-6">Get started by creating your first feature for this project.</p>
    </div>
  <% end %>
</div>
