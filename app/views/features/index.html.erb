<% content_for :title, "Features - #{@project.name}" %>
<div class="max-w-3xl mx-auto px-4 py-12">
  <!-- Header -->
  <%= render Shared::PageHeaderComponent.new(
    title: "Features",
    subtitle: "Manage features for #{@project.name}"
  ) do |c| %>
    <% if @project.editor?(Current.user) || @project.admin?(Current.user) %>
      <% c.with_actions do %>
        <%= button_to "New feature", project_features_path(@project), method: :post, class: "btn btn-primary" %>
      <% end %>
    <% end %>
  <% end %>

  <!-- Search Bar -->
  <div class="mb-6">
    <%= render Shared::SearchInputComponent.new(
      url: project_features_path(@project),
      target_id: "features-container",
      placeholder: "Search features by title, description, or tags...",
      value: params[:q]
    ) %>
  </div>

  <!-- Features List with Search Results Info -->
  <div id="features-container">
    <% if params[:q].present? %>
      <p class="mb-4 text-sm text-stone-500 dark:text-white/50">
        Showing results for "<span class="font-medium text-stone-700 dark:text-white/70"><%= params[:q] %></span>"
      </p>
    <% end %>
    <%= render partial: "features/features", locals: { features: @features, project: @project } %>
  </div>
</div>
