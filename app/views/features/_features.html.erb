<div id="features">
  <% if features.any? %>
    <div class="space-y-2">
      <% features.each do |feature| %>
        <%= render Features::CardComponent.new(feature: feature, project: project) %>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="flex flex-col items-center justify-center py-16 text-center">
      <svg class="w-12 h-12 mb-4 text-stone-300 dark:text-white/20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
      </svg>
      <p class="text-sm mb-1 text-stone-500 dark:text-white/60">No features yet</p>
      <p class="text-sm text-stone-400 dark:text-white/40">Create your first feature to get started</p>
    </div>
  <% end %>
  <%= render "shared/flash_alert", alert: alert if defined?(alert) && alert.present? %>
  <%= render "shared/flash_notice", notice: notice if defined?(notice) && notice.present? %>
</div>
