<div id="features">
  <% if features.any? %>
    <div>
      <% features.each do |feature| %>
        <%= render FeatureCardComponent.new(feature: feature, project: project) %>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="flex flex-col items-center justify-center py-24 text-center">
      <div class="mb-6">
        <svg class="w-20 h-20 mx-auto text-zinc-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
      </div>
      <h3 class="text-xl font-medium text-zinc-500 dark:text-gray-400 mb-2">No features yet</h3>
      <p class="text-base text-zinc-400 dark:text-gray-500 max-w-md">Get started by creating your first feature for this project.</p>
    </div>
  <% end %>
  <%= render "shared/flash_alert", alert: alert if defined?(alert) && alert.present? %>
  <%= render "shared/flash_notice", notice: notice if defined?(notice) && notice.present? %>
</div>

