  <head>
    <title><%= content_for(:title) || "Gwirian" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/logo.png" type="image/png">
    <link rel="icon" href="/logo.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/logo.png">

    <%# Typography: Plus Jakarta Sans for a distinctive, readable UI (frontend-design) %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
    <script src="/js/htmx.2.0.4.min.js"></script>
    <script src="/js/alpine-drag-drop.js"></script>
    <script defer src="/js/alpinejs.3.14.8.js"></script>
    <script src="/js/popper.js"></script>
    <script src="/js/tippy.js"></script>
    <%if Gwirian.saas? %>
      <%= render "layouts/paddle" %>
    <% end %>
    <script>
      document.addEventListener("alpine:init", () => {
        Alpine.store("notifications", {
          showAlert: false,
          showNotice: false,
          showError: false,
          alertMessage: "",
          noticeMessage: "",
          errorMessage: ""
        })
      });
    </script>
  </head>
