<!DOCTYPE html>
<html>
  <%= render "layouts/head" %>
  <body hx-boost="true" hx-headers='{"X-CSRF-Token": "<%= form_authenticity_token %>"}' class="body">
    <div class="auth-layout">
      <div class="flex min-h-screen">
        <!-- Form Section (45%) -->
        <div class="auth-form-section">
          <%= yield %>
        </div>

        <!-- Preview Section (55%) -->
        <%= render "shared/dashboard_preview" %>
      </div>
    </div>
    <%= render partial: "layouts/notification" %>
  </body>
</html>
