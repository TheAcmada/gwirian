<dialog id="confirmDialog" class="rounded p-0 w-full max-w-md mx-auto mt-12 bg-white dark:bg-stone-900 border border-stone-200 dark:border-white/10 panel-shadow">
  <form method="dialog" class="p-5 flex flex-col gap-4">
    <h2 class="text-base font-semibold text-stone-800 dark:text-white/90">Confirm action</h2>
    <p data-confirm-message class="text-sm text-stone-500 dark:text-white/60"></p>
    <div class="flex justify-end gap-2">
      <button type="button" class="btn btn-ghost" data-confirm-cancel>Cancel</button>
      <button type="button" class="btn btn-primary" data-confirm-yes>Confirm</button>
    </div>
  </form>
</dialog>
