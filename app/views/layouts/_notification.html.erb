<div class="notification-container"
      x-data
      x-show="$store.notifications.showNotice"
      x-init="
        $store.notifications.noticeMessage= '<%= notice %>';
        setTimeout(() => $store.notifications.showNotice = <%= notice.present? %>, 100);
        setTimeout(() => $store.notifications.showNotice = false, 5000)"
      x-transition:enter="transition ease-out duration-250"
      x-transition:enter-start="opacity-0 translate-y-2"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 translate-y-1"
      @click="$store.notifications.showNotice = false"
      role="alert"
      aria-live="polite">
  <div class="px-4 py-3 rounded flex items-center gap-2 text-sm text-white bg-emerald-600">
    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
    </svg>
    <span x-text="$store.notifications.noticeMessage" class="flex-1"></span>
    <button @click="$store.notifications.showNotice = false" aria-label="Close notification" class="ml-2 cursor-pointer opacity-70 hover:opacity-100">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
</div>

<div class="alert-container"
      x-data
      x-show="$store.notifications.showAlert"
      x-init="
        $store.notifications.alertMessage= '<%= j(alert) %>';
        setTimeout(() => $store.notifications.showAlert = <%= alert.present? %>, 100);
        setTimeout(() => $store.notifications.showAlert = false, 5000);"
      x-transition:enter="transition ease-out duration-250"
      x-transition:enter-start="opacity-0 translate-y-2"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 translate-y-1"
      @click="$store.notifications.showAlert = false"
      role="alert"
      aria-live="polite">
  <div class="px-4 py-3 rounded flex items-center gap-2 text-sm text-white bg-amber-500">
    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
    </svg>
    <span x-text="$store.notifications.alertMessage" class="flex-1"></span>
    <button @click="$store.notifications.showAlert = false" aria-label="Close notification" class="ml-2 cursor-pointer opacity-70 hover:opacity-100">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
</div>

<div class="error-container"
      x-data
      x-show="$store.notifications.showError"
      x-init="
        $store.notifications.errorMessage= '<%= j(error) %>';
        setTimeout(() => $store.notifications.showError = <%= error.present? %>, 100);
        setTimeout(() => $store.notifications.showError = false, 5000)"
      x-transition:enter="transition ease-out duration-250"
      x-transition:enter-start="opacity-0 translate-y-2"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 translate-y-1"
      @click="$store.notifications.showError = false"
      role="alert"
      aria-live="polite">
  <div class="px-4 py-3 rounded flex items-center gap-2 text-sm text-white bg-red-500">
    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
    </svg>
    <span x-text="$store.notifications.errorMessage" class="flex-1"></span>
    <button @click="$store.notifications.showError = false" aria-label="Close notification" class="ml-2 cursor-pointer opacity-70 hover:opacity-100">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
</div>
