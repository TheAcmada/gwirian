<div id="scenarios-list" class="mb-8">
  <h2 class="text-xl font-semibold text-zinc-900 dark:text-white mb-4">Scenarios</h2>

  <div
    id="scenarios-container"
    class="space-y-4"
    x-data
    x-init="
      <% if feature.project.editor?(Current.user) || feature.project.admin?(Current.user) %>
        new Sortable($el, {
          handle: '.drag-handle',
          animation: 150,
          onEnd: (evt) => {
            htmx.ajax('POST', '<%= reorder_project_feature_scenarios_path(project, feature) %>', {
              values: {
                'order[]': Array.from($el.children).map(e => e.dataset.id)
              },
              swap: 'none'
            });
          }
        });
      <% end %>
      $el.addEventListener('htmx:afterSwap', () => {
        const noScenariosMsg = document.getElementById('no-scenarios-message');
        if (noScenariosMsg) {
          noScenariosMsg.remove();
        }
      });
    "
  >
    <% if feature.scenarios.any? %>
      <% feature.scenarios.each do |scenario| %>
        <%= render ScenarioComponent.new(scenario: scenario, feature: feature, project: project) %>
      <% end %>
    <% else %>
      <p id="no-scenarios-message" class="text-zinc-500 dark:text-gray-400 italic mb-4">No scenarios yet</p>
    <% end %>
  </div>

  <% if feature.project.editor?(Current.user) || feature.project.admin?(Current.user) %>
    <div class="mt-4">
      <a
        href="<%= project_feature_scenarios_path(project, feature) %>"
        hx-post="<%= project_feature_scenarios_path(project, feature) %>"
        hx-target="#scenarios-container"
        hx-swap="beforeend"
        class="inline-flex items-center gap-2 text-zinc-600 dark:text-gray-400 hover:text-zinc-900 dark:hover:text-white transition-colors"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>Add New Scenario</span>
      </a>
    </div>
  <% end %>
</div>

