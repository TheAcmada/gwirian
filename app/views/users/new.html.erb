<%= render "shared/desktop_logo" %>

<div class="auth-form-container">
  <div class="auth-form-card">
    <%= render "shared/mobile_logo" %>

    <!-- Title and subtitle -->
    <h1 class="text-2xl font-semibold text-center mb-1 text-stone-800 dark:text-white/90">Create account</h1>
    <p class="text-center mb-6 text-stone-500 dark:text-white/60">Sign up to start managing your tests</p>

    <!-- Form -->
    <%= form_with model: @user, url: users_path, method: :post, local: true do |f| %>
      <div class="space-y-4">
        <% if @user.errors.any? %>
          <div class="rounded p-3 bg-red-50 dark:bg-red-900/20">
            <ul class="text-sm space-y-1 text-red-600 dark:text-red-400">
              <% @user.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :email_address, "Email", class: "block text-sm font-medium mb-1 text-stone-800 dark:text-white/90" %>
          <%= f.email_field :email_address,
              required: true,
              autofocus: true,
              class: "input",
              placeholder: "you@example.com" %>
        </div>

        <p class="text-sm text-stone-500 dark:text-white/60">
          We'll send you a verification code to sign in. No password needed.
        </p>

        <!-- Honeypot field -->
        <div style="display:none">
          <%= f.label :nickname, "Leave this field blank" %>
          <%= f.text_field :nickname, autocomplete: "off" %>
        </div>

        <div>
          <%= f.submit "Get started", class: "btn btn-primary w-full" %>
        </div>
      </div>
    <% end %>

    <!-- Sign in link -->
    <div class="text-center mt-6">
      <p class="text-stone-500 dark:text-white/60">
        Already have an account?
        <%= link_to "Sign in", new_session_path, class: "link" %>
      </p>
    </div>
  </div>
</div>
