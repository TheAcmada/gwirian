<% content_for :title, "Profile" %>
<div class="max-w-3xl mx-auto px-4 py-12">
  <!-- Page Header -->
  <div class="mb-8">
    <h1 class="text-4xl font-bold tracking-tight mb-2 text-stone-800 dark:text-white/90" style="letter-spacing: -0.02em;">Profile</h1>
    <p class="text-stone-500 dark:text-white/60">Manage your account settings</p>
  </div>

  <div class="space-y-8">
    <!-- Email Section -->
    <div>
      <h2 class="text-sm font-medium mb-4 text-stone-500 dark:text-white/60">Email</h2>
      <div class="bg-stone-50 dark:bg-white/5 rounded-lg p-4">
        <p class="text-stone-800 dark:text-white/90"><%= @user.email_address %></p>
        <p class="text-xs text-stone-400 dark:text-white/40 mt-1">You sign in using a verification code sent to this email</p>
      </div>
    </div>

    <!-- API Token Section -->
    <div>
      <h2 class="text-sm font-medium mb-4 text-stone-500 dark:text-white/60">API Token</h2>
      <%= render 'api_token', user: @user %>
    </div>

    <!-- Danger Zone -->
    <div class="pt-6 border-t border-red-200 dark:border-red-900/30">
      <div class="bg-red-50 dark:bg-red-900/10 rounded-lg p-6">
        <h2 class="text-sm font-medium mb-4 text-red-600 dark:text-red-400">Danger Zone</h2>
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-red-600 dark:text-red-400">Delete account</p>
            <p class="text-xs text-stone-400 dark:text-white/40">This action cannot be undone</p>
          </div>
          <% delete_confirmation_message = "Are you absolutely sure? This will permanently delete your account and all your data. This action cannot be undone." %>
          <%= button_to "Delete",
                        user_path(@user),
                        method: :delete,
                        "x-data": "{}",
                        "@click.prevent": "showConfirmation(\"#{delete_confirmation_message}\").then(result => { if (result.isConfirmed) $el.closest('form').submit() })",
                        class: "btn btn-danger" %>
        </div>
      </div>
    </div>
  </div>
</div>
