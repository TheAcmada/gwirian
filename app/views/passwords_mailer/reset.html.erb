<div style="max-width: 480px; margin: 0 auto; font-family: Arial, sans-serif; background: #fff; border-radius: 8px; box-shadow: 0 2px 8px #e2e8f0; padding: 32px 24px;">
  <h2 style="font-size: 22px; font-weight: bold; color: #0f172a; margin-bottom: 18px;">Reset your password</h2>
  <p style="font-size: 16px; color: #334155; margin-bottom: 24px;">
    You requested a password reset. Click the button below to set a new password. This link is valid for 15 minutes.
  </p>
  <div style="text-align: center; margin-bottom: 24px;">
    <a href="<%= edit_password_url(@user.password_reset_token) %>"
       style="display: inline-block; background: #0ea5e9; color: #fff; font-weight: 600; padding: 12px 28px; border-radius: 6px; text-decoration: none; font-size: 16px;">
      Reset Password
    </a>
  </div>
  <p style="font-size: 14px; color: #64748b; margin-bottom: 0;">
    If the button above doesn't work, copy and paste this link into your browser:<br>
    <span style="word-break: break-all; color: #0ea5e9;">
      <%= edit_password_url(@user.password_reset_token) %>
    </span>
  </p>
  <p style="font-size: 13px; color: #64748b; margin-top: 32px;">
    If you did not request a password reset, you can safely ignore this email.
  </p>
</div>
