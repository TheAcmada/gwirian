<%= render "shared/desktop_logo" %>

<div class="auth-form-container">
  <div class="auth-form-card">
    <%= render "shared/mobile_logo" %>

    <!-- Title and subtitle -->
    <h1 class="text-2xl font-semibold text-center mb-1 text-stone-800 dark:text-white/90">Update your password</h1>
    <p class="text-center mb-6 text-stone-500 dark:text-white/60">Enter your new password below</p>

    <!-- Form -->
    <%= form_with url: password_path(params[:token]), method: :put, local: true do |form| %>
      <div class="space-y-4">
        <div>
          <%= form.label :password, "New password", class: "block text-sm font-medium mb-1 text-stone-800 dark:text-white/90" %>
          <%= form.password_field :password,
              required: true,
              autocomplete: "new-password",
              placeholder: "Enter new password",
              maxlength: 72,
              class: "input" %>
        </div>

        <div>
          <%= form.label :password_confirmation, "Confirm password", class: "block text-sm font-medium mb-1 text-stone-800 dark:text-white/90" %>
          <%= form.password_field :password_confirmation,
              required: true,
              autocomplete: "new-password",
              placeholder: "Confirm your password",
              maxlength: 72,
              class: "input" %>
        </div>

        <div>
          <%= form.submit "Save password", class: "btn btn-primary w-full" %>
        </div>
      </div>
    <% end %>

    <!-- Back link -->
    <div class="text-center mt-6">
      <p class="text-stone-500 dark:text-white/60">
        Remember your password?
        <%= link_to "Back to sign in", new_session_path, class: "text-blue-600 dark:text-blue-400 hover:underline" %>
      </p>
    </div>
  </div>
</div>
