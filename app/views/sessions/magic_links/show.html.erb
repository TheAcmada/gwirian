<%= render "shared/desktop_logo" %>

<div class="auth-form-container">
  <div class="auth-form-card">
    <%= render "shared/mobile_logo" %>

    <!-- Title and subtitle -->
    <h1 class="text-2xl font-semibold text-center mb-1 text-stone-800 dark:text-white/90">Check your email</h1>
    <p class="text-center mb-6 text-stone-500 dark:text-white/60">
      Enter the verification code sent to<br>
      <strong class="text-stone-700 dark:text-white/80"><%= email_address_pending_authentication %></strong>
    </p>

    <!-- Form -->
    <%= form_with url: session_magic_link_path, method: :post, local: true do |f| %>
      <div class="space-y-4">
        <div>
          <%= f.label :code, "Verification code", class: "block text-sm font-medium mb-1 text-stone-800 dark:text-white/90" %>
          <%= f.text_field :code,
              class: "input text-center text-2xl tracking-widest uppercase",
              required: true,
              autofocus: true,
              autocomplete: "one-time-code",
              autocorrect: "off",
              autocapitalize: "characters",
              spellcheck: "false",
              maxlength: "6",
              placeholder: "••••••",
              data: { "1p-ignore": true } %>
        </div>

        <p class="text-sm text-center text-stone-500 dark:text-white/60">
          The code will work for <%= distance_of_time_in_words(MagicLink::EXPIRATION_TIME) %>.
        </p>

        <div>
          <%= f.submit "Verify", class: "btn btn-primary w-full" %>
        </div>
      </div>
    <% end %>

    <!-- Back to sign in -->
    <div class="text-center mt-6">
      <p class="text-stone-500 dark:text-white/60">
        Didn't receive the code?
        <%= link_to "Try again", new_session_path, class: "link" %>
      </p>
    </div>
  </div>
</div>

<% if Rails.env.development? && flash[:magic_link_code].present? %>
  <div class="fixed bottom-4 left-4 z-50 bg-amber-100 dark:bg-amber-900/50 border border-amber-300 dark:border-amber-700 rounded-lg p-4 shadow-lg">
    <div class="flex items-center gap-3">
      <span class="text-xs font-bold uppercase text-amber-600 dark:text-amber-400">Dev</span>
      <span class="text-sm text-amber-700 dark:text-amber-300">Code:</span>
      <code class="text-lg font-bold text-amber-900 tracking-wider"><%= flash[:magic_link_code] %></code>
    </div>
  </div>
<% end %>
