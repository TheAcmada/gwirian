<%= render "shared/desktop_logo" %>

<div class="auth-form-container">
  <div class="auth-form-card">
    <%= render "shared/mobile_logo" %>

    <!-- Title and subtitle -->
    <h1 class="text-2xl font-semibold text-center mb-1 text-stone-800 dark:text-white/90">Welcome back</h1>
    <p class="text-center mb-6 text-stone-500 dark:text-white/60">Enter your email and we'll send you a code</p>

    <!-- Form -->
    <%= form_with url: session_path, method: :post, local: true do |f| %>
      <div class="space-y-4">
        <div>
          <%= f.label :email_address, "Email", class: "block text-sm font-medium mb-1 text-stone-800 dark:text-white/90" %>
          <%= f.email_field :email_address,
              class: "input",
              required: true,
              autofocus: true,
              autocomplete: "email",
              placeholder: "Enter your email" %>
        </div>

        <div>
          <%= f.submit "Get code", class: "btn btn-primary w-full" %>
        </div>
      </div>
    <% end %>

    <!-- Sign up link -->
    <div class="text-center mt-6">
      <p class="text-stone-500 dark:text-white/60">
        Don't have an account?
        <%= link_to "Sign up", new_user_path, class: "link" %>
      </p>
    </div>
  </div>
</div>
