    <%= render "shared/desktop_logo" %>

    <div class="auth-form-container">
      <div class="auth-form-card">
        <%= render "shared/mobile_logo" %>

        <!-- Title and subtitle -->
        <h1 class="auth-title">Welcome Back</h1>
        <p class="auth-subtitle">Enter your email and password to access your account</p>

    <!-- Form -->
    <%= form_with url: session_path, method: :post, local: true do |f| %>
      <div class="space-y-6">
        <div>
          <%= f.label :email_address, "Email address", class: "label" %>
          <%= f.email_field :email_address,
              class: "input",
              required: true,
              autofocus: true,
              autocomplete: "email",
              placeholder: "Enter your email address" %>
        </div>

        <div>
          <%= f.label :password, "Password", class: "label" %>
          <%= f.password_field :password,
              class: "input",
              required: true,
              autocomplete: "current-password",
              placeholder: "Enter your password" %>
        </div>

        <div class="flex justify-end">
          <%= link_to "Forgot your password?", new_password_path, class: "link" %>
        </div>

        <div>
          <%= f.submit "Sign in", class: "btn btn-primary w-full py-3 text-base font-medium" %>
        </div>
      </div>
    <% end %>

    <!-- Sign up link -->
    <div class="text-center mt-6">
      <p class="text-zinc-600 dark:text-gray-400">
        No account?
        <%= link_to "Sign up", new_user_path, class: "link font-medium text-accent-600 dark:text-accent-400" %>
      </p>
    </div>
  </div>
</div>
