<nav class="border-b border-stone-200 dark:border-white/10 bg-white dark:bg-[rgb(25,25,25)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Main navbar row -->
    <div class="flex justify-between items-center h-11">
      <!-- App name/logo on the left -->
      <div class="flex-shrink-0">
        <%= link_to root_path, class: "flex items-center space-x-2 text-sm font-medium hover:bg-stone-100 dark:hover:bg-white/5 rounded px-2 py-1 -ml-2 transition-colors" do %>
          <img src="/logo.svg" alt="Testtiz Logo" class="h-5 w-5 dark:brightness-150 dark:invert" />
          <span class="text-stone-800 dark:text-white/90">Testtiz</span>
        <% end %>
      </div>

      <!-- User dropdown on the right -->
      <% username = Current.user&.email_address&.split('@')&.first || "User" %>
      <div class="relative" x-data="{ open: false }">
        <button
          @click="open = !open"
          class="flex items-center gap-2 px-2 py-1 -mr-2 rounded cursor-pointer hover:bg-stone-100 dark:hover:bg-white/5 transition-colors"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span class="text-sm text-stone-600 dark:text-white/70"><%= username %></span>
          <span class="flex items-center justify-center w-6 h-6 rounded bg-stone-100 dark:bg-white/10 text-xs font-medium text-stone-600 dark:text-white/80">
            <%= username.first.upcase %>
          </span>
        </button>

        <!-- Dropdown menu -->
        <div
          x-show="open"
          @click.away="open = false"
          x-transition:enter="transition ease-out duration-100"
          x-transition:enter-start="opacity-0 scale-95"
          x-transition:enter-end="opacity-100 scale-100"
          x-transition:leave="transition ease-in duration-75"
          x-transition:leave-start="opacity-100 scale-100"
          x-transition:leave-end="opacity-0 scale-95"
          class="absolute right-0 mt-1 w-56 py-1 z-50 bg-white dark:bg-[rgb(37,37,37)] rounded shadow-lg"
          style="box-shadow: rgba(15, 15, 15, 0.05) 0px 0px 0px 1px, rgba(15, 15, 15, 0.1) 0px 3px 6px, rgba(15, 15, 15, 0.2) 0px 9px 24px;"
          role="menu"
          aria-orientation="vertical"
          x-cloak
        >
          <!-- User info header -->
          <%= link_to edit_user_path(Current.user), class: "block px-3 py-2 border-b border-stone-100 dark:border-white/10 hover:bg-stone-100 dark:hover:bg-white/5 transition-colors" do %>
            <p class="text-sm font-medium text-stone-800 dark:text-white/90"><%= username %></p>
            <p class="text-xs text-stone-400 dark:text-white/40"><%= Current.user&.email_address %></p>
          <% end %>

          <!-- Menu items -->
          <div class="py-1">
            <%= form_with url: session_path, method: :delete, local: true, class: "block" do |f| %>
              <button type="submit"
                      class="w-full text-left px-3 py-1.5 text-sm text-stone-700 dark:text-white/90 transition-colors cursor-pointer flex items-center hover:bg-stone-100 dark:hover:bg-white/5"
                      role="menuitem">
                <svg class="w-4 h-4 mr-2 text-stone-400 dark:text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                </svg>
                Log out
              </button>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Project bar row (only shown when @project is present and persisted) -->
    <% if @project.present? && @project.persisted? %>
      <div class="py-2 border-t border-stone-100 dark:border-white/5">
        <%= render 'projects/project_bar', project: @project %>
      </div>
    <% end %>
  </div>
</nav>
