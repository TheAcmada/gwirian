<nav class="border-b border-stone-200 dark:border-white/10 bg-white dark:bg-[rgb(25,25,25)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Main navbar row -->
    <div class="flex justify-between items-center h-11">
      <!-- App name/logo on the left -->
      <div class="flex-shrink-0">
        <%= link_to root_path, class: "flex items-center space-x-2 text-sm font-medium hover:bg-stone-100 dark:hover:bg-white/5 rounded px-2 py-1 -ml-2 transition-colors duration-200 hover:scale-[1.02] active:scale-[0.98]" do %>
          <img src="/logo.svg" alt="Gwirian Logo" class="h-5 w-5 dark:brightness-150 dark:invert" />
          <span class="text-stone-800 dark:text-white/90">Gwirian</span>
        <% end %>
      </div>

      <!-- User dropdown on the right -->
      <% username = Current.user&.email_address&.split('@')&.first || "User" %>
      <div class="relative" x-data="{ open: false }">
        <button
          @click="open = !open"
          class="flex items-center gap-2 px-2 py-1 -mr-2 rounded cursor-pointer hover:bg-stone-100 dark:hover:bg-white/5 transition-colors duration-200 hover:scale-[1.02] active:scale-[0.98]"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span class="text-sm text-stone-600 dark:text-white/70"><%= username %></span>
          <span class="flex items-center justify-center w-6 h-6 rounded bg-stone-100 dark:bg-white/10 text-xs font-medium text-stone-600 dark:text-white/80">
            <%= username.first.upcase %>
          </span>
        </button>

        <!-- Dropdown menu -->
        <% user_workspaces = Current.user&.workspace_members&.current_member&.includes(:workspace) || [] %>
        <div
          x-show="open"
          @click.away="open = false"
          x-transition:enter="transition ease-out duration-100"
          x-transition:enter-start="opacity-0 scale-95"
          x-transition:enter-end="opacity-100 scale-100"
          x-transition:leave="transition ease-in duration-75"
          x-transition:leave-start="opacity-100 scale-100"
          x-transition:leave-end="opacity-0 scale-95"
          class="absolute right-0 mt-1 py-1 z-50 w-[300px] rounded bg-white dark:bg-stone-900 panel-shadow"
          x-data="{ showWorkspaces: false }"
          role="menu"
          aria-orientation="vertical"
          x-cloak
        >
          <!-- User info header -->
          <%= link_to edit_user_path(Current.user), class: "block px-3 py-2 hover:bg-stone-100 dark:hover:bg-white/5 transition-colors cursor-pointer flex items-center" do %>
            <svg class="w-4 h-4 mr-2 text-stone-400 dark:text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            <span class="text-sm font-medium text-stone-800 dark:text-white/90">My account</span>
          <% end %>

          <% if Gwirian.saas? && Current.workspace.present? %>
            <%= link_to subscription_path, class: "block px-3 py-1.5 hover:bg-stone-100 dark:hover:bg-white/5 transition-colors cursor-pointer flex items-center border-b border-stone-100 dark:border-white/10" do %>
              <svg class="w-4 h-4 mr-2 text-stone-400 dark:text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
              </svg>
              <span class="text-sm text-stone-700 dark:text-white/90">Plan & billing</span>
            <% end %>
          <% end %>

          <!-- Search -->
          <% if Current.workspace.present? %>
            <button
              type="button"
              @click="open = false; window.dispatchEvent(new CustomEvent('command-palette:open'))"
              class="w-full text-left px-3 py-1.5 text-sm text-stone-700 dark:text-white/90 transition-colors cursor-pointer flex items-center hover:bg-stone-100 dark:hover:bg-white/5 border-b border-stone-100 dark:border-white/10"
              role="menuitem"
            >
              <svg class="w-4 h-4 mr-2 text-stone-400 dark:text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
              Quick search
            </button>
          <% end %>

          <!-- Team members -->
          <% if Current.workspace && Current.workspace.admin?(Current.user) %>
            <%= link_to workspace_members_path, class: "block px-3 py-1.5 text-sm text-stone-700 dark:text-white/90 transition-colors cursor-pointer flex items-center hover:bg-stone-100 dark:hover:bg-white/5 border-b border-stone-100 dark:border-white/10" do %>
              <svg class="w-4 h-4 mr-2 text-stone-400 dark:text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
              Manage team
            <% end %>
          <% end %>

          <!-- Change workspace (click to toggle) -->
          <div class="py-1 border-b border-stone-100 dark:border-white/10">
            <button
              type="button"
              @click="showWorkspaces = !showWorkspaces"
              class="w-full text-left px-3 py-1.5 text-sm transition-colors cursor-pointer flex items-center justify-between hover:bg-stone-100 dark:hover:bg-white/5"
              :class="{ 'bg-stone-100 dark:bg-white/5': showWorkspaces }"
              role="menuitem"
              aria-haspopup="true"
              :aria-expanded="showWorkspaces"
            >
              <span class="flex items-center">
                <svg class="w-4 h-4 mr-2 text-stone-400 dark:text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l4-4 4 4m0 6l-4 4-4-4"></path>
                </svg>
                Change workspace
              </span>
              <svg
                class="w-4 h-4 text-stone-400 dark:text-white/50 transition-transform duration-200"
                :class="{ 'rotate-90': showWorkspaces }"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </button>

            <!-- Inline workspace list (folds/unfolds) -->
            <div
              x-show="showWorkspaces"
              x-transition:enter="transition ease-out duration-100"
              x-transition:enter-start="opacity-0"
              x-transition:enter-end="opacity-100"
              x-transition:leave="transition ease-in duration-75"
              x-transition:leave-start="opacity-100"
              x-transition:leave-end="opacity-0"
              class="border-t border-stone-100 dark:border-white/10 mt-1"
            >
              <!-- Workspace list -->
              <div class="py-1 max-h-64 overflow-y-auto">
                <% if user_workspaces.any? %>
                  <% user_workspaces.each_with_index do |membership, index| %>
                    <% workspace = membership.workspace %>
                    <% is_current = workspace == Current.workspace %>
                    <% truncated_name = workspace.name.length > 20 ? "#{workspace.name[0...20]}..." : workspace.name %>
                    <%= link_to "/#{workspace.slug}/projects",
                        class: "flex items-center px-3 py-1.5 text-sm transition-colors #{is_current ? 'text-stone-900 dark:text-white' : 'text-stone-700 dark:text-white/90'} hover:bg-stone-100 dark:hover:bg-white/5" do %>
                      <span class="flex-1"><%= index + 1 %>. <%= truncated_name %></span>
                      <% if is_current %>
                        <svg class="w-4 h-4 ml-2 text-teal-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                      <% end %>
                    <% end %>
                  <% end %>
                <% else %>
                  <p class="px-3 py-2 text-sm text-stone-400 dark:text-white/40 italic">No workspaces yet</p>
                <% end %>
              </div>

              <!-- Create or join workspace link -->
              <div class="border-t border-stone-100 dark:border-white/10 py-1">
                <% pending_count = Current.user&.pending_workspace_invitations&.count || 0 %>
                <%= link_to new_workspace_path,
                    class: "flex items-center justify-between px-3 py-1.5 text-sm text-stone-700 dark:text-white/90 hover:bg-stone-100 dark:hover:bg-white/5 transition-colors" do %>
                  <span>Create or join a workspace</span>
                  <% if pending_count > 0 %>
                    <span class="ml-2 px-1.5 py-0.5 text-xs font-medium rounded bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400">
                      <%= pending_count %>
                    </span>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Log out -->
          <div class="py-1">
            <%= form_with url: session_path, method: :delete, local: true, class: "block" do |f| %>
              <button type="submit"
                      class="w-full text-left px-3 py-1.5 text-sm text-stone-700 dark:text-white/90 transition-colors cursor-pointer flex items-center hover:bg-stone-100 dark:hover:bg-white/5"
                      role="menuitem">
                <svg class="w-4 h-4 mr-2 text-stone-400 dark:text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                </svg>
                Sign out
              </button>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Project bar row (only shown when @project is present and persisted) -->
    <% if @project.present? && @project.persisted? %>
      <div class="py-2 border-t border-stone-100 dark:border-white/5">
        <%= render 'projects/project_bar', project: @project %>
      </div>
    <% end %>
  </div>
</nav>
