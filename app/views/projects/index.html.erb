<% content_for :title, t('activerecord.models.project.other') %>
<div class="max-w-5xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-8">
    <h1 class="title">Projects</h1>
    <a href="<%= new_project_path %>" class="btn btn-primary">+ New Project</a>
  </div>

  <% if @projects.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      <% @projects.each do |project| %>
        <%= render 'project_card', project: project %>
      <% end %>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center py-24">
      <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder-dot-icon lucide-folder-dot"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/><circle cx="12" cy="13" r="1"/></svg>
      <p class="text-lg text-gray-500 dark:text-gray-400 mb-2">No projects yet</p>
      <a href="<%= new_project_path %>" class="btn btn-primary mt-2">Create your first project</a>
    </div>
  <% end %>
</div>
