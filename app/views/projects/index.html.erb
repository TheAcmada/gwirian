<% content_for :title, "Projects" %>
<div class="max-w-6xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-4xl font-bold tracking-tight text-stone-800 dark:text-white/90" style="letter-spacing: -0.02em;">Projects</h1>
    <% if can? :create, Project %>
      <a href="<%= new_project_path %>" class="btn btn-primary">New project</a>
    <% end %>
  </div>

  <% if @projects.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      <% @projects.each do |project| %>
        <%= render Projects::CardComponent.new(project: project) %>
      <% end %>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center py-16 text-center">
      <svg class="w-12 h-12 mb-4 text-stone-300 dark:text-white/20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
      </svg>
      <p class="text-sm mb-1 text-stone-500 dark:text-white/60">No projects yet</p>
      <% if can? :create, Project %>
        <p class="text-sm mb-4 text-stone-400 dark:text-white/40">Get started by creating your first project</p>
        <a href="<%= new_project_path %>" class="btn btn-primary">Create project</a>
      <% else %>
        <p class="text-sm mb-4 text-stone-400 dark:text-white/40">Ask a workspace administrator to create a project</p>
      <% end %>
    </div>
  <% end %>
</div>
