<div id="project-members-<%= project.id %>" class="space-y-1">
  <% project.project_members.by_email.each do |member| %>
    <div class="flex items-center justify-between py-2 px-3 rounded transition-colors hover:bg-stone-50 dark:hover:bg-white/5">
      <div class="flex items-center gap-3">
        <div class="w-6 h-6 rounded flex items-center justify-center text-xs font-medium bg-stone-100 dark:bg-white/10 text-stone-700 dark:text-white/90">
          <%= member.email.first.upcase %>
        </div>
        <div class="min-w-0">
          <div class="text-sm text-stone-800 dark:text-white/90 truncate"><%= member.email %></div>
          <div class="text-xs text-stone-400 dark:text-white/40">Since <%= member.created_at.strftime("%b %d, %Y") %></div>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <% if can?(:update, member) %>
          <%= select_tag "project_member[role]",
            options_for_select([["Admin", "administrator"], ["Editor", "editor"], ["Viewer", "viewer"]], member.role),
            "hx-patch": update_member_project_path(project, member_id: member.id),
            "hx-target": "#project-members-#{project.id}",
            "hx-trigger": "change",
            "hx-swap": "outerHTML",
            id: "member-role-#{member.id}",
            class: "input h-7 text-xs w-24 py-0" %>
        <% else %>
          <span class="text-xs px-1.5 py-0.5 rounded bg-stone-100 dark:bg-white/10 text-stone-500 dark:text-white/60">
            <%= member.role.humanize %>
          </span>
        <% end %>

        <% unless member.workspace_member? %>
          <span class="text-xs px-1.5 py-0.5 rounded bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400"
                x-data
                x-tooltip="'This user is no longer a member of the workspace'">
            Not in workspace
          </span>
        <% end %>

        <div class="flex items-center gap-1">
          <% if can?(:remove, member) %>
            <button title="Remove member"
                    class="p-1 rounded cursor-pointer transition-colors hover:bg-stone-100 dark:hover:bg-white/10 text-stone-500 dark:text-white/60"
                    hx-delete="<%= remove_member_project_path(project, member_id: member.id) %>"
                    hx-target="#project-members-<%= project.id %>"
                    hx-swap="outerHTML"
                    hx-trigger="confirmed"
                    x-data="{}"
                    @click.prevent="showConfirmation('Are you sure you want to remove this member?').then(result => {
                      if (result.isConfirmed) {
                        htmx.trigger($el, 'confirmed')
                      }
                    })">
              <%= delete_icon %>
            </button>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
<%= render "shared/flash_alert", alert: alert if alert.present? %>
<%= render "shared/flash_notice", notice: notice if notice.present? %>
