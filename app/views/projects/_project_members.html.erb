<table id="project-members-<%= project.id %>" class="table divide-gray-200 mb-4">
  <thead>
    <tr>
      <th class="thead">Member</th>
      <th class="thead">Role</th>
      <th class="thead" width="120px">Status</th>
      <th width="40px"></th>
    </tr>
  </thead>
  <tbody class="divide-y divide-gray-100">
    <% project.project_members.each do |member| %>
      <tr>
        <td class="px-4 py-2">
          <div class="font-medium"><%= member.email %></div>
          <div class="text-xs text-gray-400">Since <%= member.created_at.strftime("%B %d, %Y") %></div>
        </td>
        <td class="px-4 py-2">
          <% if can?(:update, member) %>
            <%= select_tag "project_member[role]",
              options_for_select([["administrator", "administrator"], ["editor", "editor"], ["viewer", "viewer"]], member.role),
              "hx-patch": update_member_project_path(project, member_id: member.id),
              "hx-target": "#project-members-#{project.id}",
              "hx-trigger": "change",
              "hx-swap": "outerHTML",
              id: "member-role-#{member.id}",
              class: "input" %>
          <% else %>
            <span class="inline-block <%= case member.role
                when 'administrator' then 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200'
                when 'editor' then 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200'
                when 'viewer' then 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200'
                else 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200'
                end %> text-xs px-3 py-1 rounded"><%= member.role %></span>
          <% end %>
        </td>
        <td class="px-4 py-2">
          <% if member.invitation_accepted %>
            <span class="inline-block bg-green-100 text-green-800 text-xs px-3 py-1 rounded">Active</span>
          <% else %>
            <span class="inline-block bg-yellow-100 text-yellow-800 text-xs px-3 py-1 rounded">Pending</span>
          <% end %>
        </td>
        <td class="px-4 py-2">
          <div class="flex flex-row gap-2">
            <% if !member.invitation_accepted && can?(:update, member) %>
              <button title="Resend invitation"
                      hx-post="<%= resend_invitation_project_member_path(member) %>"
                      hx-target="#project-members-#{project.id}"
                      hx-swap="outerHTML">
                <%= resend_icon %>
              </button>
            <% end %>
            <% if can?(:remove, member) %>
              <button title="Remove member"
                      hx-delete="<%= remove_member_project_path(project, member_id: member.id) %>"
                      hx-target="#project-members-#{project.id}"
                      hx-swap="outerHTML"
                      hx-trigger="confirmed"
                      x-data="{}"
                      @click.prevent="showConfirmation('Are you sure you want to remove this member?').then(result => {
                        if (result.isConfirmed) {
                          htmx.trigger($el, 'confirmed')
                        }
                      })">
                <%= delete_icon %>
              </button>
            <% end %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= render "shared/flash_alert", alert: alert if alert.present? %>
<%= render "shared/flash_notice", notice: notice if notice.present? %>
