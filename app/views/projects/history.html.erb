<% content_for :title, "History - #{@project.name}" %>

<div class="max-w-6xl mx-auto px-4 py-8">
  <%# Header %>
  <div class="mb-8">
    <h1 class="text-3xl font-bold tracking-tight text-stone-800 dark:text-white" style="letter-spacing: -0.02em;">
      Execution History
    </h1>
    <p class="mt-2 text-base text-stone-600 dark:text-stone-300">
      View all test executions for <%= @project.name %>
    </p>
  </div>

  <%# Search Bar %>
  <div class="mb-6">
    <div class="relative" x-data="{ query: '' }" x-init="query = $refs.searchInput.value">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-400 dark:text-white/40 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <input type="text"
             name="q"
             x-ref="searchInput"
             x-model="query"
             value="<%= params[:q] %>"
             placeholder="Search by feature, scenario, user, status, or notes..."
             class="input w-full pl-10 pr-10"
             autocomplete="off"
             hx-get="<%= history_project_path(@project) %>"
             hx-trigger="keyup changed delay:300ms"
             hx-target="#history-container"
             hx-select="#history-container"
             hx-swap="outerHTML"
             hx-push-url="true" />
      <button type="button"
              x-show="query.length > 0"
              x-cloak
              @click="query = ''; $refs.searchInput.value = ''; htmx.ajax('GET', '<%= history_project_path(@project) %>', {target: '#history-container', select: '#history-container', swap: 'outerHTML'})"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-stone-400 hover:text-stone-600 dark:text-white/40 dark:hover:text-white/70 transition-colors cursor-pointer"
              title="Clear search">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <%# History Container with Search Results Info %>
  <div id="history-container">
    <% if params[:q].present? %>
      <p class="mb-4 text-sm text-stone-500 dark:text-white/50">
        Showing results for "<span class="font-medium text-stone-700 dark:text-white/70"><%= params[:q] %></span>"
      </p>
    <% end %>

    <%# Table %>
    <%= render History::TableComponent.new(executions: @executions, project: @project) %>

    <%# Pagination %>
    <% if @pagy.pages > 1 %>
      <div class="mt-6">
        <%= render "shared/pagination", pagy: @pagy %>
      </div>
    <% end %>
  </div>
</div>

