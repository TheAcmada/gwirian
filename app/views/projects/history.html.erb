<% content_for :title, "History - #{@project.name}" %>

<div class="max-w-6xl mx-auto px-4 py-8">
  <%# Header %>
  <div class="mb-8">
    <h1 class="text-3xl font-bold tracking-tight text-stone-800 dark:text-white" style="letter-spacing: -0.02em;">
      Execution History
    </h1>
    <p class="mt-2 text-base text-stone-600 dark:text-stone-300">
      View all test executions for <%= @project.name %>
    </p>
  </div>

  <%# Table %>
  <%= render History::TableComponent.new(executions: @executions, project: @project) %>

  <%# Pagination %>
  <% if @pagy.pages > 1 %>
    <div class="mt-6">
      <%= render "shared/pagination", pagy: @pagy %>
    </div>
  <% end %>
</div>

