<% content_for :title, "History - #{@project.name}" %>

<div class="max-w-6xl mx-auto px-4 py-8">
  <%# Header %>
  <%= render Shared::PageHeaderComponent.new(
    title: "Execution History",
    subtitle: "View all test executions for #{@project.name}"
  ) %>

  <%# Search Bar %>
  <div class="mb-6">
    <%= render Shared::SearchInputComponent.new(
      url: history_project_path(@project),
      target_id: "history-container",
      placeholder: "Search by feature, scenario, user, status, or notes...",
      value: params[:q]
    ) %>
  </div>

  <%# History Container with Search Results Info %>
  <div id="history-container">
    <% if params[:q].present? %>
      <p class="mb-4 text-sm text-stone-500 dark:text-white/50">
        Showing results for "<span class="font-medium text-stone-700 dark:text-white/70"><%= params[:q] %></span>"
      </p>
    <% end %>

    <%# Table %>
    <%= render History::TableComponent.new(executions: @executions, project: @project) %>

    <%# Pagination %>
    <% if @pagy.pages > 1 %>
      <div class="mt-6">
        <%= render "shared/pagination", pagy: @pagy %>
      </div>
    <% end %>
  </div>
</div>

