<% content_for :title, @project.name %>
<div class="max-w-3xl mx-auto px-4 py-12">
  <!-- Project Header -->
  <div class="mb-8">
    <h1 class="text-4xl font-bold tracking-tight mb-2 text-stone-800 dark:text-white/90" style="letter-spacing: -0.02em;"><%= @project.name %></h1>
    <% if @project.description.present? %>
      <p class="text-base leading-relaxed text-stone-800 dark:text-white/90"><%= @project.description %></p>
    <% else %>
      <p class="text-stone-400 dark:text-white/30">Add a description...</p>
    <% end %>
  </div>

  <!-- Project Details -->
  <div class="mb-8">
    <h2 class="text-sm font-medium mb-3 text-stone-500 dark:text-white/60">Details</h2>

    <div class="space-y-3">
      <div class="flex items-center gap-3 py-1">
        <span class="text-sm w-24 text-stone-500 dark:text-white/60">Name</span>
        <span class="text-sm text-stone-800 dark:text-white/90"><%= @project.name %></span>
      </div>

      <div class="flex items-center gap-3 py-1">
        <span class="text-sm w-24 text-stone-500 dark:text-white/60">Created</span>
        <span class="text-sm text-stone-800 dark:text-white/90"><%= @project.created_at.strftime("%B %d, %Y") %></span>
      </div>

      <% if @project.description.present? %>
        <div class="flex gap-3 py-1">
          <span class="text-sm w-24 flex-shrink-0 text-stone-500 dark:text-white/60">Description</span>
          <span class="text-sm leading-relaxed text-stone-800 dark:text-white/90"><%= @project.description %></span>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Project Members Section -->
  <% if @project.project_members.any? %>
    <div>
      <h2 class="text-sm font-medium mb-3 text-stone-500 dark:text-white/60">Team</h2>
      <div class="space-y-1">
        <% @project.project_members.each do |member| %>
          <div class="flex items-center justify-between py-2 px-3 rounded transition-colors hover:bg-stone-50 dark:hover:bg-white/5">
            <div class="flex items-center">
              <div class="w-6 h-6 rounded flex items-center justify-center mr-2 text-xs font-medium bg-stone-100 dark:bg-white/10 text-stone-700 dark:text-white/90">
                <%= member.email.first.upcase %>
              </div>
              <span class="text-sm text-stone-800 dark:text-white/90"><%= member.email %></span>
            </div>
            <span class="text-xs px-1.5 py-0.5 rounded bg-stone-100 dark:bg-white/10 text-stone-500 dark:text-white/60">
              <%= member.role.humanize %>
            </span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
