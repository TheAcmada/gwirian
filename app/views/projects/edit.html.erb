<% content_for :title, "Edit #{@project.name}" %>
<div class="max-w-3xl mx-auto px-4 py-12">
  <!-- Page Header -->
  <div class="mb-8">
    <h1 class="text-4xl font-bold tracking-tight mb-2 text-stone-800 dark:text-white/90" style="letter-spacing: -0.02em;">Settings</h1>
    <p class="text-stone-500 dark:text-white/60">Manage project details and team</p>
  </div>

  <div class="space-y-8">
    <!-- Project Details Form -->
    <div>
      <h2 class="text-sm font-medium mb-4 text-stone-500 dark:text-white/60">Project Details</h2>
      <%= form_with model: @project, local: true do |f| %>
        <%= render 'shared/errors', model: @project %>

        <div class="mb-4">
          <%= f.label :name, "Name", class: 'block text-sm font-medium mb-1 text-stone-800 dark:text-white/90' %>
          <%= f.text_field :name, class: 'input', placeholder: "Enter project name", autofocus: true %>
        </div>

        <div class="mb-4">
          <%= f.label :description, "Description", class: 'block text-sm font-medium mb-1 text-stone-800 dark:text-white/90' %>
          <%= f.text_area :description, class: 'input h-24', placeholder: "Describe your project" %>
        </div>

        <div class="flex justify-end gap-2">
          <%= link_to "Cancel", project_path(@project), class: 'btn btn-ghost' %>
          <%= f.submit "Save changes", class: 'btn btn-primary' %>
        </div>
      <% end %>
    </div>

    <!-- Project Members Management -->
    <div>
      <h2 class="text-sm font-medium mb-4 text-stone-500 dark:text-white/60">Team Members</h2>
      <%= render "projects/project_members", project: @project %>
      <% if can? :add_member, @project %>
        <form hx-post="<%= add_member_project_path(@project) %>"
              hx-target="#project-members-<%= @project.id %>"
              hx-swap="outerHTML"
              class="flex gap-2 items-center mt-4">
          <input type="email" name="project_member[email]" class="input flex-1" placeholder="Email address" required>
          <select name="project_member[role]" class="input w-36">
            <option value="administrator">Admin</option>
            <option value="editor">Editor</option>
            <option value="viewer" selected>Viewer</option>
          </select>
          <button type="submit" class="btn btn-primary">Add</button>
        </form>
      <% end %>
    </div>

    <!-- Danger Zone -->
    <% if can? :destroy, @project %>
      <div class="pt-6 border-t border-red-200 dark:border-red-900/30">
        <h2 class="text-sm font-medium mb-4 text-red-600 dark:text-red-400">Danger Zone</h2>
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-red-600 dark:text-red-400">Delete project</p>
            <p class="text-xs text-stone-400 dark:text-white/40">This action cannot be undone</p>
          </div>
          <% delete_confirmation_message = "Are you absolutely sure? This will permanently delete the project '#{@project.name}' and all its data. This action cannot be undone." %>
          <%= button_to "Delete",
                        project_path(@project),
                        method: :delete,
                        "x-data": "{}",
                        "@click.prevent": "showConfirmation(\"#{delete_confirmation_message}\").then(result => { if (result.isConfirmed) $el.closest('form').submit() })",
                        class: "btn btn-danger" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
