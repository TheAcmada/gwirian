<div class="flex items-center justify-between">
  <!-- Project info on the left -->
  <div class="flex items-center space-x-4">
    <!-- Project icon and name -->
    <div class="flex items-center space-x-2">
      <svg class="w-5 h-5 text-zinc-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
      </svg>
      <span class="text-sm font-medium text-zinc-900 dark:text-white"><%= project.name %></span>
    </div>
  </div>

  <!-- Navigation menu -->
  <nav class="flex items-center space-x-1">
    <!-- Dashboard -->
    <%= link_to project_path(project),
        class: "inline-flex items-center px-3 py-2 text-sm font-medium rounded-md transition-colors #{'bg-zinc-100 text-zinc-900 dark:bg-gray-700 dark:text-white' if controller_name == 'projects' && action_name == 'show'} #{'text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 dark:text-gray-300 dark:hover:text-white dark:hover:bg-gray-700' unless controller_name == 'projects' && action_name == 'show'}" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"></path>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5a2 2 0 012-2h4a2 2 0 012 2v2H8V5z"></path>
      </svg>
      Dashboard
    <% end %>

    <!-- Features -->
    <%= link_to "#",
        class: "inline-flex items-center px-3 py-2 text-sm font-medium rounded-md transition-colors #{'bg-zinc-100 text-zinc-900 dark:bg-gray-700 dark:text-white' if controller_name == 'test_cases'} #{'text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 dark:text-gray-300 dark:hover:text-white dark:hover:bg-gray-700' unless controller_name == 'test_cases'}" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      Features
    <% end %>

    <!-- Tests history -->
    <%= link_to "#",
        class: "inline-flex items-center px-3 py-2 text-sm font-medium rounded-md transition-colors text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 dark:text-gray-300 dark:hover:text-white dark:hover:bg-gray-700" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"></path>
      </svg>
      Tests history
    <% end %>

    <!-- Settings -->
    <%= link_to edit_project_path(project),
        class: "inline-flex items-center px-3 py-2 text-sm font-medium rounded-md transition-colors #{'bg-zinc-100 text-zinc-900 dark:bg-gray-700 dark:text-white' if controller_name == 'projects' && action_name == 'edit'} #{'text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 dark:text-gray-300 dark:hover:text-white dark:hover:bg-gray-700' unless controller_name == 'projects' && action_name == 'edit'}" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
      </svg>
      Settings
    <% end %>
  </nav>
</div>
