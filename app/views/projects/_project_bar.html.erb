<div class="flex items-center justify-between">
  <!-- Project info with breadcrumb style -->
  <div class="flex items-center text-sm text-stone-500 dark:text-white/50">
    <svg class="w-4 h-4 mr-1.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
    </svg>
    <span class="font-medium text-stone-800 dark:text-white/90 truncate max-w-[120px] sm:max-w-none"><%= project.name %></span>
  </div>

  <!-- Navigation menu - Icons on mobile, text on desktop -->
  <nav class="flex items-center gap-0.5 sm:gap-0.5">
    <%
      nav_items = [
        {
          path: project_path(project),
          label: 'Dashboard',
          active: controller_name == 'projects' && action_name == 'show',
          icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>'
        },
        {
          path: project_features_path(project),
          label: 'Features',
          active: controller_name == 'features',
          icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>'
        },
        {
          path: history_project_path(project),
          label: 'History',
          active: controller_name == 'projects' && action_name == 'history',
          icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>'
        },
        {
          path: edit_project_path(project),
          label: 'Settings',
          active: controller_name == 'projects' && action_name == 'edit',
          icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>'
        }
      ]
    %>

    <% nav_items.each_with_index do |item, index| %>
      <% if index > 0 %>
        <span class="hidden sm:inline text-stone-300 dark:text-white/20 mx-0.5">/</span>
      <% end %>
      <%= link_to item[:path],
          class: "px-2 py-1 text-sm rounded transition-colors flex items-center gap-1.5 #{item[:active] ? 'font-medium text-stone-800 dark:text-white/90 bg-stone-100 dark:bg-white/10' : 'text-stone-500 dark:text-white/50 hover:bg-stone-100 dark:hover:bg-white/5 hover:text-stone-800 dark:hover:text-white/90'}" do %>
        <svg class="w-4 h-4 sm:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <%= item[:icon].html_safe %>
        </svg>
        <span class="hidden sm:inline"><%= item[:label] %></span>
      <% end %>
    <% end %>
  </nav>
</div>
