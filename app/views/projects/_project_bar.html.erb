<div class="flex items-center justify-between">
  <!-- Project info with breadcrumb style -->
  <div class="flex items-center text-sm text-stone-500 dark:text-white/50">
    <svg class="w-4 h-4 mr-1.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
    </svg>
    <span class="font-medium text-stone-800 dark:text-white/90"><%= project.name %></span>
  </div>

  <!-- Navigation menu - Notion-style text links -->
  <nav class="flex items-center gap-0.5">
    <% nav_items = [
      { path: project_path(project), label: 'Dashboard', active: controller_name == 'projects' && action_name == 'show' },
      { path: project_features_path(project), label: 'Features', active: controller_name == 'features' },
      { path: history_project_path(project), label: 'History', active: controller_name == 'projects' && action_name == 'history' },
      { path: edit_project_path(project), label: 'Settings', active: controller_name == 'projects' && action_name == 'edit' }
    ] %>

    <% nav_items.each_with_index do |item, index| %>
      <% if index > 0 %>
        <span class="text-stone-300 dark:text-white/20 mx-0.5">/</span>
      <% end %>
      <%= link_to item[:path],
          class: "px-2 py-1 text-sm rounded transition-colors #{item[:active] ? 'font-medium text-stone-800 dark:text-white/90 bg-stone-100 dark:bg-white/10' : 'text-stone-500 dark:text-white/50 hover:bg-stone-100 dark:hover:bg-white/5 hover:text-stone-800 dark:hover:text-white/90'}" do %>
        <%= item[:label] %>
      <% end %>
    <% end %>
  </nav>
</div>
